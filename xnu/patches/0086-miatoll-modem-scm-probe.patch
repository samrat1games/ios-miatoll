diff --git a/bsd/dev/sweet_modem.inc b/bsd/dev/sweet_modem.inc
new file mode 100644
index 0000000..4de0262
--- /dev/null
+++ b/bsd/dev/sweet_modem.inc
@@ -0,0 +1,79 @@
+/*
+ * miatoll modem / Wi-Fi bring-up (WCN3990 sits behind the Q6 modem DSP). Included by sweet_touch.c.
+ * Step 1: is the Qualcomm secure monitor (TZ) reachable through SMCCC SIP calls, and does it offer the
+ * peripheral-image-loader (PIL, svc 2) calls the Linux subsys-pil-tz driver uses for the modem (pas-id 4)?
+ * Boot-arg sweetmodem=0 disables the probe.
+ */
+#define SM_SVC_INFO     0x6u
+#define SM_SVC_PIL      0x2u
+#define SM_INFO_AVAIL   0x1u
+
+static uint64_t
+sm_smc(uint64_t id, uint64_t info, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *r1, uint64_t *r2, uint64_t *r3)
+{
+	register uint64_t x0 __asm__("x0") = id;
+	register uint64_t x1 __asm__("x1") = info;
+	register uint64_t x2 __asm__("x2") = a0;
+	register uint64_t x3 __asm__("x3") = a1;
+	register uint64_t x4 __asm__("x4") = a2;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6) : :
+	    "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	if (r1) {
+		*r1 = x1;
+	}
+	if (r2) {
+		*r2 = x2;
+	}
+	if (r3) {
+		*r3 = x3;
+	}
+	return x0;
+}
+
+/* SMCCC function id: fast(1)/std(0) << 31, SMC64 << 30, owner SIP (2) << 24, svc << 8 | cmd. */
+#define SM_FID(fast, svc, cmd)  (((uint64_t)(fast) << 31) | (1ULL << 30) | (2ULL << 24) | ((uint64_t)(svc) << 8) | (cmd))
+
+static void
+sm_probe(void)
+{
+	uint64_t r1 = 0, r2 = 0, r3 = 0, r0;
+	r0 = sm_smc(0x80000000ULL, 0, 0, 0, 0, &r1, NULL, NULL);       /* SMCCC_VERSION */
+	printf("SWEET MODEM: SMCCC version x0=%#llx\n", r0);
+	static const struct { const char *name; unsigned cmd; } pil[] = {
+		{"PAS_INIT_IMAGE", 1}, {"PAS_MEM_SETUP", 2}, {"PAS_AUTH_AND_RESET", 5}, {"PAS_SHUTDOWN", 6},
+	};
+	for (unsigned f = 0; f < 2; ++f) {
+		for (unsigned i = 0; i < 4; ++i) {
+			r0 = sm_smc(SM_FID(f, SM_SVC_INFO, SM_INFO_AVAIL), 1, (SM_SVC_PIL << 8) | pil[i].cmd, 0, 0, &r1, &r2, &r3);
+			printf("SWEET MODEM: SCM IS_CALL_AVAIL(PIL %s) %s: x0=%#llx x1=%#llx x2=%#llx\n",
+			    pil[i].name, f ? "fast" : "std", r0, r1, r2);
+		}
+	}
+}
+
+static void
+sm_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	touch_wait(70 * 1000u);
+	sm_probe();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+sweet_modem_start(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	(void)PE_parse_boot_argn("sweetmodem", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	if (kernel_thread_start(sm_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
