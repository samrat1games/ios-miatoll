 	RedwoodGPU * gpu;
 	uint32_t cached = 0;
 
-	gGPUCached = PE_parse_boot_argn("gpu_cached", &cached, sizeof(cached)) && cached != 0;
+	/* 0173 (0157 was skipped by the CI): cached memory by default; gpu_cached=0 is write-combined */
+	gGPUCached = !PE_parse_boot_argn("gpu_cached", &cached, sizeof(cached)) || cached != 0;
 	PE_parse_boot_argn("touch_lat", &gWaitLines, sizeof(gWaitLines));
