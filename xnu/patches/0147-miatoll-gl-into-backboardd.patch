diff --git a/bsd/dev/miatoll_adreno.c b/bsd/dev/miatoll_adreno.c
index cad9692..bad44a2 100644
--- a/bsd/dev/miatoll_adreno.c
+++ b/bsd/dev/miatoll_adreno.c
@@ -4028,6 +4028,7 @@ redwood_adreno_quiesce(void)
 #define GPU_RECOVERIES          64                      /* at most in one run: a program that hangs every submission fills no log with this */
 
 static bool gpu_kept;
+static volatile int adreno_starting;    /* 0147: gpu=1's thread has not finished yet */
 static uint32_t adreno_done, adreno_failed;   /* ios-miatoll: for the later summary line */
 extern uint32_t redwood_gpu_service;       /* RedwoodGPU.cpp: 1 once registered */
 static uint32_t gpu_fence;              /* the number of the last submission */
@@ -5161,6 +5162,7 @@ miatoll_adreno_thread(void *arg, wait_result_t result)
 	}
 	printf("adreno: firmware (" MIATOLL_GPU_FW_DIR "a618_gmu.bin) %s after %u s\n", s < wait_s ? "found" : "NOT found", s);
 	redwood_adreno_init();
+	adreno_starting = 0;
 	/* ios-miatoll: the USB log streams only after userland is up and its replay drops lines: say it again later */
 	sleep_ms(90 * 1000);
 	printf("adreno: summary: last step done %u, failed %u, the GPU %s, service RedwoodGPU %s\n", adreno_done,
@@ -5169,6 +5171,46 @@ miatoll_adreno_thread(void *arg, wait_result_t result)
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * ios-miatoll 0147: kern_exec.c asks this for every program it starts. backboardd (the window server)
+ * gets DYLD_INSERT_LIBRARIES=/private/var/miatoll/libredwood-gl.dylib (HackiOS userland/src/eagl.c on
+ * Mesa freedreno: CoreAnimation's EAGLContext drawn by the GPU through RedwoodGPU) when the GPU is
+ * kept on and the library is there; boot-arg gl=0: never. While the GPU is still being started
+ * (gpu=1), backboardd waits for it, up to 30 s. dyld honours the variable because of 0146.
+ */
+#define MIATOLL_GL_LIBRARY      MIATOLL_GPU_FW_DIR "libredwood-gl.dylib"
+
+const char *miatoll_gl_env(const char *path);
+const char *
+miatoll_gl_env(const char *path)
+{
+	static int said;
+	uint32_t gl = 1;
+	vnode_t vp = NULLVP;
+
+	if (path == NULL || strcmp(path, "/usr/libexec/backboardd") != 0) {
+		return NULL;
+	}
+	if (PE_parse_boot_argn("gl", &gl, sizeof(gl)) && gl == 0) {
+		return NULL;
+	}
+	for (unsigned waited = 0; adreno_starting && waited < 300; waited++) {
+		sleep_ms(100);
+	}
+	if (!redwood_gpu_service || vnode_lookup(MIATOLL_GL_LIBRARY, 0, &vp, vfs_context_kernel()) != 0) {
+		if (said++ < 4) {
+			printf("adreno: backboardd draws in software (%s)\n", redwood_gpu_service ? "no " MIATOLL_GL_LIBRARY :
+			    "no RedwoodGPU");
+		}
+		return NULL;
+	}
+	vnode_put(vp);
+	if (said++ < 4) {
+		printf("adreno: backboardd gets " MIATOLL_GL_LIBRARY ": CoreAnimation draws with the GPU\n");
+	}
+	return "DYLD_INSERT_LIBRARIES=" MIATOLL_GL_LIBRARY;
+}
+
 void miatoll_adreno_start(void);
 void
 miatoll_adreno_start(void)
@@ -5180,7 +5222,10 @@ miatoll_adreno_start(void)
 	    !(PE_parse_boot_argn("gpu", &value, sizeof(value)) && value)) {
 		return;
 	}
+	adreno_starting = 1;
 	if (kernel_thread_start(miatoll_adreno_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
+	} else {
+		adreno_starting = 0;
 	}
 }
