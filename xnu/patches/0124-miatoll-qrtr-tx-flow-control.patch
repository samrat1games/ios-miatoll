+/*
+ * Flow control as Linux qrtr_tx_wait(): at most 10 DATA packets to one remote port, the 6th asks for
+ * confirmation (confirm_rx) and the remote's RESUME_TX lets the next 10 go. Without it the modem drops
+ * what comes after its quota (WLANMDSP.MBN stopped after block 10, one TFTP window).
+ */
+#define QRTR_FLOW_HIGH  10u
+#define QRTR_FLOW_N     8
+static struct { uint32_t node, port, pending, blocked; int used; } qrtr_flow[QRTR_FLOW_N];
+static unsigned qrtr_flow_next;
+
+static int
+qrtr_flow_find(uint32_t node, uint32_t port, int make)
+{
+	for (int i = 0; i < QRTR_FLOW_N; ++i) {
+		if (qrtr_flow[i].used && qrtr_flow[i].node == node && qrtr_flow[i].port == port) {
+			return i;
+		}
+	}
+	if (!make) {
+		return -1;
+	}
+	int i = (int)(qrtr_flow_next++ % QRTR_FLOW_N);
+	qrtr_flow[i].used = 1;
+	qrtr_flow[i].node = node;
+	qrtr_flow[i].port = port;
+	qrtr_flow[i].pending = 0;
+	qrtr_flow[i].blocked = 0;
+	return i;
+}
+
+/* send one QRTR packet (header first) on GLINK, unless its destination has used up its quota */
+static int
+qrtr_tx_pkt(uint8_t *pkt, uint32_t len)
+{
+	uint32_t h[8];
+	memcpy(h, pkt, 32);
+	int f = -1;
+	if (h[1] == QRTR_TYPE_DATA) {
+		f = qrtr_flow_find(h[6], h[7], 1);
+		if (qrtr_flow[f].pending >= QRTR_FLOW_HIGH) {
+			if (++qrtr_flow[f].blocked < 5000) {
+				return EAGAIN;
+			}
+			/* no RESUME_TX for a long time: send anyway, as before flow control */
+			printf("SWEET QRTR: no RESUME_TX from %u:%#x, sending on\n", h[6], h[7]);
+			qrtr_flow[f].pending = 0;
+		}
+		qrtr_flow[f].blocked = 0;
+		h[4] = qrtr_flow[f].pending == QRTR_FLOW_HIGH / 2;
+		memcpy(pkt + 16, &h[4], 4);
+	}
+	int e = gl_send(pkt, len);
+	if (!e && f >= 0) {
+		qrtr_flow[f].pending++;
+	}
+	return e;
+}
