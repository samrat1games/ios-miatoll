diff --git a/bsd/dev/sweet_modem.inc b/bsd/dev/sweet_modem.inc
--- a/bsd/dev/sweet_modem.inc
+++ b/bsd/dev/sweet_modem.inc
@@ -3258,6 +3258,29 @@ wl_wmi_wait(unsigned ms_total, volatile int *flag)
 	}
 }
 
+/* 0182: the scan result as /private/var/miatoll/networks.txt, one network a line: SSID, BSSID, channel, snr (tab separated) */
+static void
+wl_write_networks(void)
+{
+	static char out[3072];
+	size_t n = 0;
+	for (unsigned i = 0; i < wl_nbss && n + 120 < sizeof(out); ++i) {
+		const struct wl_bss *b = &wl_bss[i];
+		n += (size_t)snprintf(out + n, sizeof(out) - n, "%s\t%02x:%02x:%02x:%02x:%02x:%02x\t%u\t%d\n", b->ssid_len ? b->ssid : "(hidden)",
+		    b->bssid[0], b->bssid[1], b->bssid[2], b->bssid[3], b->bssid[4], b->bssid[5], b->channel, b->snr);
+	}
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int e = vnode_open("/private/var/miatoll/networks.txt", O_CREAT | FWRITE | O_TRUNC, 0644, 0, &vp, ctx);
+	int resid = 0;
+	if (!e) {
+		e = vn_rdwr(UIO_WRITE, vp, (caddr_t)out, (int)n, 0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+		(void)vnode_close(vp, FWRITE, ctx);
+	}
+	printf("SWEET WIFI: networks.txt, %u networks, %zu bytes, error %d\n", wl_nbss, n, e);
+}
+
 /* the whole WMI bring-up after HTC setup complete; every step says what it did */
 static int
 wl_wmi_bringup(void)
@@ -3284,6 +3307,7 @@ wl_wmi_bringup(void)
 	wl_wmi_scan();
 	wl_wmi_wait(15000, &wl_scan_done);
 	printf("SWEET WMI: scan %s, %u access points\n", wl_scan_done ? "complete" : "did not complete", wl_nbss);
+	wl_write_networks();
 	return 0;
 }
 
