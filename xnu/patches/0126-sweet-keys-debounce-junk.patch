diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index f0e2a31..4f28477 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -94,14 +94,25 @@ keys_wait(void)
 static void
 keys_thread(void *arg, wait_result_t result)
 {
-	int state[3] = {0, 0, 0};
-	unsigned errors = 0;
+	int state[3] = {0, 0, 0}, seen[3] = {0, 0, 0};
+	unsigned same[3] = {0, 0, 0}, errors = 0, junk = 0;
 	(void)arg;
 	(void)result;
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		/*
+		 * With the modem running, a read now and then returns junk (pon 0x93, gpio 0x34: every key down at
+		 * once = a screenshot). PON RT_STS has no bits above 3, the GPIO status only bit 0: drop such reads,
+		 * and change a key only after 3 equal reads in a row (60 ms).
+		 */
+		if ((pok && (pon & 0xf0u)) || (gok && (gpio & 0xfeu))) {
+			if ((junk++ % 50u) == 0) {
+				printf("SWEET KEYS: junk read pon=%#x gpio=%#x (%u so far)\n", pon, gpio, junk);
+			}
+			pok = gok = false;
+		}
 		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
@@ -112,7 +123,12 @@ keys_thread(void *arg, wait_result_t result)
 			errors = 0;
 		}
 		for (int k = 0; k < 3; ++k) {
-			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+			if (!(k == 1 ? gok : pok)) {
+				continue;
+			}
+			same[k] = now[k] == seen[k] ? same[k] + 1 : 1;
+			seen[k] = now[k];
+			if (same[k] >= 3 && now[k] != state[k]) {
 				state[k] = now[k];
 				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
 				    k, state[k], pon, gpio);
