 {
 	socket_t so = NULL;
-	char buf[64];
+	static char buf[1600];   /* fput carries up to 1400 data bytes */
 
 	for (;;) {
 		if (!ud.configured) {
@@ -863,6 +929,12 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 			continue;               /* timeout */
 		}
 		buf[got] = 0;
+		if (got > 5 && memcmp(buf, "fput ", 5) == 0) {
+			char reply[96];
+			(void)ud_fput(buf, got, reply, sizeof(reply));
+			ud_cmd_send(so, &from, reply);
+			continue;
+		}
 		while (got > 0 && (buf[got - 1] == '\n' || buf[got - 1] == '\r' || buf[got - 1] == ' ')) {
 			buf[--got] = 0;
 		}
