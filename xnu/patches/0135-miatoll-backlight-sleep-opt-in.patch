 void
 sweet_backlight_power(int on)
 {
-	(void)sm_bl_apply(on ? (unsigned)sm_bl_level : 0);
+	/* opt-in (sweetblsleep=1): a boot with 0132 panicked after display changes, the SPMI write from this
