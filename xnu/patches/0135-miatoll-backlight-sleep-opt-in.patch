+	static int checked, enabled;
+	if (!checked) {
+		checked = 1;
+		(void)PE_parse_boot_argn("sweetblsleep", &enabled, sizeof(enabled));
+	}
+	if (enabled) {
+		(void)sm_bl_apply(on ? (unsigned)sm_bl_level : 0);
+	}
 }
 
