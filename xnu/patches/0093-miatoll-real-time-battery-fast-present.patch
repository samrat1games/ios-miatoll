+static int
+sm_rtc_read(uint16_t apid, uint32_t *secs)
+{
+	uint8_t v[4], again = 0;
+	for (unsigned tries = 0; tries < 3; ++tries) {
+		for (unsigned i = 0; i < 4; ++i) {
+			if (sp_read(apid, 0x48 + i, &v[i])) {
+				return EIO;
+			}
+		}
+		/* the low byte can roll over between the four reads: read it again and retry if it went backwards */
+		if (sp_read(apid, 0x48, &again) == 0 && again >= v[0]) {
+			break;
+		}
+	}
+	*secs = v[0] | (v[1] << 8) | (v[2] << 16) | ((uint32_t)v[3] << 24);
+	return 0;
