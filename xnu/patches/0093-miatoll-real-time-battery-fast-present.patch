+/* RTC_WRITE 0x40..0x43, RTC_CTRL 0x46 (bit 7 = enable); same sequence as Linux qpnp-rtc: stop, byte 0 = 0, bytes
+ * 1-3, byte 0, start. The counter is always started again, whatever happened in between. */
+static int
+sm_rtc_write(uint16_t apid, uint32_t secs)
+{
+	uint8_t ctrl = 0;
+	if (sp_read(apid, 0x46, &ctrl) || sp_write(apid, 0x46, ctrl & 0x7fu, 1)) {
+		return EIO;
+	}
+	int e = sp_write(apid, 0x40, 0, 1);
+	if (!e) {
+		e = sp_write(apid, 0x41, secs >> 8, 3);
+	}
+	if (!e) {
+		e = sp_write(apid, 0x40, secs & 0xffu, 1);
+	}
+	(void)sp_write(apid, 0x46, ctrl | 0x80u, 1);
+	return e ? EIO : 0;
