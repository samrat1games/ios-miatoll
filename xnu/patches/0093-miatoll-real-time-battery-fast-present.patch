+ * that time into the PMIC counter, so every later boot starts with the right time and no boot-arg at all. If the
+ * PMIC refuses the write the offset is kept in RAM only (read back after every write: nothing is assumed).
+ */
+#define SM_RTC_FLOOR    1792627200ULL   /* 2026-10-22 00:00:00 UTC */
+#define SM_RTC_REAL_MIN 1767225600ULL   /* 2026-01-01 00:00:00 UTC */
+#define SM_RTC_SLACK    8               /* seconds of drift between the system clock and the counter that are ignored */
