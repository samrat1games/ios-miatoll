+	uint32_t owner = sm_r32(sp_cnfg + 0x700u + 4u * sp_wled_apid) & 7u;
+	if (owner != 0) {
+		printf("SWEET BL: apid %#x belongs to EE %u, not the apps processor: brightness not changed\n", sp_wled_apid, owner);
+		return EPERM;
+	}
 	int e = sp_write(sp_wled_apid, 0x53, (level & 0xff) | (((level >> 8) & 0xf) << 8), 2);
 	if (!e) {
 		e = sp_write(sp_wled_apid, 0x65, 1, 1);
