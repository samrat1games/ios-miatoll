diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index bc6e848..3388793 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -361,6 +361,46 @@ static struct mac_policy_conf sweet_sandbox_mac_conf = {
 
 static mac_policy_handle_t sweet_sandbox_mac_handle;
 
+/*
+ * Policy "AMFI" (0146): dyld asks it what a process may do with DYLD_* variables
+ * (amfi_check_dyld_policy_self() = __mac_syscall("AMFI", 90, {in flags, out flags pointer})).
+ * Answered: everything but a custom shared cache, so DYLD_INSERT_LIBRARIES works in stock
+ * daemons (the GPU's GL library in backboardd, NOTES "Adreno 618 port").
+ */
+#define SWEET_AMFI_DYLD_POLICY_SELF     90
+#define SWEET_AMFI_DYLD_ALLOW           0xfbULL /* at/path vars, fallback, print, failed insertion, interposing, embedded */
+
+static int
+sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	static int said;
+	uint64_t args[2];
+	uint64_t allow = SWEET_AMFI_DYLD_ALLOW;
+
+	if (call != SWEET_AMFI_DYLD_POLICY_SELF) {
+		if (said++ < 8) {
+			printf("SWEET AMFI: syscall %d not handled\n", call);
+		}
+		return ENOSYS;
+	}
+	if (copyin(arg, args, sizeof(args)) != 0 || args[1] == 0) {
+		return EFAULT;
+	}
+	return copyout(&allow, (user_addr_t)args[1], sizeof(allow));
+}
+
+static const struct mac_policy_ops sweet_amfi_dyld_mac_ops = {
+	.mpo_policy_syscall = sweet_amfi_syscall,
+};
+
+static struct mac_policy_conf sweet_amfi_dyld_mac_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "SWEET dyld policy",
+	.mpc_ops = &sweet_amfi_dyld_mac_ops,
+};
+
+static mac_policy_handle_t sweet_amfi_dyld_mac_handle;
+
 static struct mac_policy_conf sweet_amfi_mac_conf = {
 	.mpc_name = "SWEET AMFI",
 	.mpc_fullname = "SWEET built-in Mobile File Integrity",
@@ -381,5 +421,7 @@ sweet_amfi_policy_register(void)
 	error = mac_policy_register(&sweet_sandbox_mac_conf, &sweet_sandbox_mac_handle, NULL);
 	printf("SWEET Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	error = mac_policy_register(&sweet_amfi_dyld_mac_conf, &sweet_amfi_dyld_mac_handle, NULL);
+	printf("SWEET AMFI: dyld policy %s (%d)\n", error ? "NOT registered" : "registered", error);
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 224303c..31c8b48 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -139,6 +139,31 @@ public:
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+static AppleCLCD *gSweetCLCD;           /* the panel, for sweet_fb_show() */
+
+/* RedwoodGPU's kRedwoodShow: a test's pixels (32 bits, blue first) at the panel's top left. */
+extern "C" void
+sweet_fb_show(const uint8_t *pixels, uint32_t width, uint32_t height, uint32_t rowBytes)
+{
+	AppleCLCD *fb = gSweetCLCD;
+
+	if (fb == NULL || fb->fPixels == 0) {
+		return;
+	}
+	if (width > fb->fWidth) {
+		width = fb->fWidth;
+	}
+	if (height > fb->fHeight) {
+		height = fb->fHeight;
+	}
+	IOLockLock(fb->fLock);
+	for (uint32_t y = 0; y < height; y++) {
+		memcpy((void *)(fb->fPixels + (uint64_t)y * fb->fRowBytes), pixels + (uint64_t)y * rowBytes, (size_t)width * 4);
+	}
+	fb->fShadowValid = false;
+	IOLockUnlock(fb->fLock);
+}
