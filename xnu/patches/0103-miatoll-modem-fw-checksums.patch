index da1b594..f6d10ed 100644
--- a/bsd/dev/sweet_modem.inc
+++ b/bsd/dev/sweet_modem.inc
@@ -199,6 +199,7 @@ sm_load_segment(const char *name, uint64_t pa, uint64_t filesz, uint64_t memsz)
 		return e;
 	}
 	uint64_t dst = pa - SM_REGION_PA;
