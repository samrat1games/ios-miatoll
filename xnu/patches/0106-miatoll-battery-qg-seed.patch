+/*
+ * Linux qpnp-qg keeps its state of charge in the PM6150 SDAM at 0xb600 (qcom,qg-sdam@b600, qg-reg.h):
+ * 0x46 valid, 0x47 SOC percent, 0x54 RTC seconds of the store. Android/recovery refresh it while running, so
+ * right after a reboot from there it is the real fuel-gauge value (recovery read 85% while the voltage curve
+ * said about 55%). Trusted when written less than 12 hours ago by the raw PMIC RTC counter (0x6048).
+ */
+bool
+SweetBattery::seedFromQG(void)
+{
+	uint8_t valid = 0, soc = 0, t[4], r[4];
+	for (unsigned i = 0; i < 4; ++i) {
+		if (sweet_spmi_read(0, 0xb654 + i, &t[i]) || sweet_spmi_read(0, 0x6048 + i, &r[i])) {
+			return false;
+		}
+	}
+	if (sweet_spmi_read(0, 0xb646, &valid) || sweet_spmi_read(0, 0xb647, &soc)) {
+		return false;
+	}
+	uint32_t stored = (uint32_t)t[0] | ((uint32_t)t[1] << 8) | ((uint32_t)t[2] << 16) | ((uint32_t)t[3] << 24);
+	uint32_t now = (uint32_t)r[0] | ((uint32_t)r[1] << 8) | ((uint32_t)r[2] << 16) | ((uint32_t)r[3] << 24);
+	uint32_t age = now >= stored ? now - stored : 0xffffffffu;
+	IOLog("SWEET BATTERY: QG SDAM valid %u soc %u%% stored at %u, rtc %u (age %d s)\n", valid, soc, stored, now,
+	    (int)age);
+	if (valid != 1 || soc > 100 || age > 12u * 3600u) {
+		return false;
+	}
+	fMilli = (int)soc * 1000;
+	fShown = soc ? soc : 1;
+	fSeeded = true;
+	return true;
+}
