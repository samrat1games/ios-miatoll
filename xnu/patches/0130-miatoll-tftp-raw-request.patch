diff --git a/bsd/dev/sweet_modem.inc b/bsd/dev/sweet_modem.inc
index 754ba48..8232f71 100644
--- a/bsd/dev/sweet_modem.inc
+++ b/bsd/dev/sweet_modem.inc
@@ -1969,8 +1969,27 @@ static void
 tftp_request(uint32_t node, uint32_t port, const uint8_t *q, uint32_t qlen)
 {
 	if (qlen < 4 || q[0] != 0 || (q[1] != TFTP_RRQ && q[1] != TFTP_WRQ)) {
+		printf("SWEET TFTP: non-request packet to the server port from %u:%#x, op %u, %u bytes\n", node, port,
+		    qlen >= 2 ? q[1] : 0, qlen);
 		return;
 	}
+	{
+		/* the raw request, NULs as '|': what does the modem ask for after the first 512 KiB of WLANMDSP? */
+		char raw[200];
+		uint32_t k = 0;
+		for (; k < qlen - 2 && k + 1 < sizeof(raw); ++k) {
+			char c = (char)q[2 + k];
+			raw[k] = c ? (c >= 32 && c < 127 ? c : '?') : '|';
+		}
+		raw[k] = 0;
+		int wl = 0;
+		for (uint32_t j = 0; j + 8 <= k && !wl; ++j) {
+			wl = !strncmp(raw + j, "wlanmdsp", 8);
+		}
+		if (wl) {
+			printf("SWEET TFTP: raw %s from %u:%#x: %s\n", q[1] == TFTP_RRQ ? "RRQ" : "WRQ", node, port, raw);
+		}
+	}
 	const char *p = (const char *)q + 2, *end = (const char *)q + qlen;
 	const char *file = p;
 	size_t fl = strnlen(file, (size_t)(end - p));
