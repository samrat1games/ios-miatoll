diff --git a/bsd/dev/sweet_modem.inc b/bsd/dev/sweet_modem.inc
index 55982ac..da1b594 100644
--- a/bsd/dev/sweet_modem.inc
+++ b/bsd/dev/sweet_modem.inc
@@ -1935,6 +1935,7 @@ sm_thread(void *arg, wait_result_t result)
 
 /* ---- test aid: boot-arg sweetbl=<seconds> restarts into the bootloader (fastboot) after that long ---- */
 static int sm_reboot_plain;     /* 1: a plain cold restart (no "into the bootloader" markers) */
+static int sm_reboot_nomodem;   /* 1: do not ask the secure world to stop the modem first (it can hold a CPU for good) */
 
 static void
 sweet_reboot_bootloader(void)
@@ -1942,7 +1943,9 @@ sweet_reboot_bootloader(void)
 	/* the two places the Android kernel leaves "reboot bootloader" for the boot chain: IMEM restart reason
 	 * and PM6150 PON_SOFT_RB_SPARE (reason 2 << 2) */
 	printf("SWEET RESET: start\n");
-	sm_modem_shutdown();
+	if (!sm_reboot_nomodem) {
+		sm_modem_shutdown();
+	}
 	vm_offset_t imem = sm_reboot_plain ? 0 : sm_window(0);
 	if (imem) {
 		sm_pmap_map_bd(imem, 0x146a8000ULL, 0x146a8000ULL + 0x4000, VM_PROT_READ | VM_PROT_WRITE);
@@ -1983,6 +1986,7 @@ void
 sweet_remote_bootloader(void)
 {
 	sm_reboot_plain = 0;
+	sm_reboot_nomodem = 1;          /* the PMIC restart resets the modem too */
 	sweet_reboot_bootloader();
 }
 
@@ -1990,6 +1994,7 @@ void
 sweet_remote_reboot(void)
 {
 	sm_reboot_plain = 1;
+	sm_reboot_nomodem = 1;
 	sweet_reboot_bootloader();
 }
 
