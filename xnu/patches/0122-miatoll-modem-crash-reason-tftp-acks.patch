 		return;
 	}
-	if (blk == 0 || (blk % 64) == 0) {
+	{
 		printf("SWEET TFTP: %s ACK %u (%llu bytes so far)\n", tftp_cl[slot].name, blk, tftp_cl[slot].sent);
