+static void
+sm_watch(void)
+{
+	printf("SWEET MODEM: watch start\n");
+	/* the window that loaded the firmware, re-pointed at SMEM */
+	sm_smem = sm_window(0);
+	if (!sm_smem) {
+		printf("SWEET MODEM: cannot map SMEM\n");
+		return;
+	}
+	sm_pmap_map_bd(sm_smem, SM_SMEM_PA, SM_SMEM_PA + SM_WIN, VM_PROT_READ | VM_PROT_WRITE);
+	__asm__ volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" : : : "memory");
+	sm_win_idx = -1;
+	sm_apcs = ml_io_map(SM_APCS_PA, 0x1000);
+	printf("SWEET MODEM: smem mapped at %#lx, apcs %#lx\n", (unsigned long)sm_smem, (unsigned long)sm_apcs);
+	sm_smem_dump();
+	sm_smp2p_setup();
+	for (unsigned t = 0; t < 600; ++t) {
+		sm_smp2p_poll();
+		if (t % 10 == 9) {
+			sm_kick(SM_IPC_SMP2P);
+		}
+		if (t == 20 || t == 100) {
+			sm_smem_dump();
+		}
+		touch_wait(250);
+	}
+	printf("SWEET MODEM: watch done\n");
+}
