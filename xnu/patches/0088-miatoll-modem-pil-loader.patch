 static void
 sm_thread(void *arg, wait_result_t result)
 {
 	(void)arg;
 	(void)result;
-	touch_wait(70 * 1000u);
+	touch_wait(10 * 1000u);
 	sm_probe();
+	int boot = 1;
+	(void)PE_parse_boot_argn("sweetmodemstd", &sm_std, sizeof(sm_std));
+	(void)PE_parse_boot_argn("sweetmodemboot", &boot, sizeof(boot));
+	if (boot) {
+		int r = sm_boot();
+		printf("SWEET MODEM: boot result %d\n", r);
+		if (!r) {
+			sm_watch();
+		}
+	}
 	(void)thread_terminate(current_thread());
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/* ---- test aid: boot-arg sweetbl=<seconds> restarts into the bootloader (fastboot) after that long ---- */
+static void
+sweet_reboot_bootloader(void)
+{
+	/* the two places the Android kernel leaves "reboot bootloader" for the boot chain: IMEM restart reason
+	 * and PM6150 PON_SOFT_RB_SPARE (reason 2 << 2) */
+	printf("SWEET RESET: start\n");
+	vm_offset_t imem = sm_window(0);
+	if (imem) {
+		sm_pmap_map_bd(imem, 0x146a8000ULL, 0x146a8000ULL + 0x4000, VM_PROT_READ | VM_PROT_WRITE);
+		__asm__ volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" : : : "memory");
+		sm_win_idx = -1;
+		sm_w32(imem + 0x2000 + 0x65c, 0x77665500u);
+		printf("SWEET RESET: imem restart reason set\n");
+	}
+	if (!sp_init()) {
+		uint16_t apid = sp_find_apid(0x008);
+		uint8_t old = 0;
+		if (apid != SP_NO_APID && !sp_read(apid, 0x8f, &old)) {
+			int e = sp_write(apid, 0x8f, (old & 3u) | (2u << 2), 1);
+			printf("SWEET RESET: PON spare %#x -> %#x (%d)\n", old, (old & 3u) | (2u << 2), e);
+		}
+	}
+	printf("SWEET RESET: restarting into the bootloader\n");
+	touch_wait(300);
+	sm_smc(0x84000009ULL, 0, 0, 0, 0, NULL, NULL, NULL);       /* PSCI SYSTEM_RESET */
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+static void
+sm_bl_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	printf("SWEET RESET: armed for %u s\n", (unsigned)(uintptr_t)arg);
+	touch_wait((unsigned)(uintptr_t)arg * 1000u);
+	sweet_reboot_bootloader();
+}
