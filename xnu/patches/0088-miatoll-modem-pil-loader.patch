+static void
+wlfw_bringup(void)
+{
+	static uint8_t t[256];
+	uint32_t rl = 0, o = 0;
+	const uint8_t *r;
+	uint8_t one = 1;
+	uint32_t cid = WLFW_CLIENT_ID;
+
+	wlan_power_on();
+	o = qmi_tlv(t, o, 0x10, &one, 1);
+	o = qmi_tlv(t, o, 0x13, &one, 1);
+	o = qmi_tlv(t, o, 0x14, &one, 1);
+	o = qmi_tlv(t, o, 0x15, &cid, 4);
+	r = qmi_call(WLFW_IND_REGISTER, t, (uint16_t)o, &rl, 3000);
+	if (qmi_result("ind_register", r, rl)) {
+		return;
+	}
+
+	uint64_t pa = WLFW_MSA_PA;
+	uint32_t sz = WLFW_MSA_SZ;
+	o = qmi_tlv(t, 0, 0x01, &pa, 8);
+	o = qmi_tlv(t, o, 0x02, &sz, 4);
+	r = qmi_call(WLFW_MSA_INFO, t, (uint16_t)o, &rl, 3000);
+	if (qmi_result("msa_info", r, rl)) {
+		return;
+	}
+	uint16_t tl;
+	const uint8_t *reg = qmi_find(r, rl, 0x03, &tl);
+	if (reg && tl >= 1) {
+		printf("SWEET WLFW: msa regions %u, tlv %u bytes\n", reg[0], tl);
+		for (uint32_t i = 0; i < reg[0] && 1 + 13 * (i + 1) <= tl; ++i) {
+			uint64_t a;
+			uint32_t zs;
+			memcpy(&a, reg + 1 + 13 * i, 8);
+			memcpy(&zs, reg + 9 + 13 * i, 4);
+			printf("SWEET WLFW:   region %u: addr %#llx size %#x secure %u\n", i, a, zs, reg[13 + 13 * i]);
+		}
+	}
+
+	r = qmi_call(WLFW_MSA_READY, t, 0, &rl, 5000);
+	qmi_result("msa_ready", r, rl);
+
+	r = qmi_call(WLFW_CAP, t, 0, &rl, 5000);
+	if (!qmi_result("cap", r, rl)) {
+		uint16_t l;
+		const uint8_t *ci = qmi_find(r, rl, 0x10, &l);
+		if (ci && l >= 8) {
+			uint32_t id, fam;
+			memcpy(&id, ci, 4);
+			memcpy(&fam, ci + 4, 4);
+			printf("SWEET WLFW: chip id %#x family %#x\n", id, fam);
+		}
+		const uint8_t *bi = qmi_find(r, rl, 0x11, &l);
+		if (bi && l >= 4) {
+			uint32_t b;
+			memcpy(&b, bi, 4);
+			printf("SWEET WLFW: board id %#x\n", b);
+		}
+		const uint8_t *fw = qmi_find(r, rl, 0x13, &l);
+		if (fw && l >= 4) {
+			uint32_t v;
+			memcpy(&v, fw, 4);
+			printf("SWEET WLFW: fw version %#x\n", v);
+		}
+	}
+}
