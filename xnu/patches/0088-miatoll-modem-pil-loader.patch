+/*
+ * Step 2: peripheral image loader for the modem (pas-id 4), the same sequence subsys-pil-tz runs on Android:
+ * INIT_IMAGE(metadata = MODEM.MDT) -> MEM_SETUP(region) -> copy the ELF segments (MODEM.Bnn) into the
+ * reserved modem region -> AUTH_AND_RESET. Firmware files come from the root file system (SM_FW_DIR),
+ * copied there from the "modem" partition (tools/fat16-ls.py).
+ */
+#define SM_PAS_ID       4u
+#define SM_FW_DIR       "/private/var/miatoll/modem/"
+#define SM_REGION_PA    0x86000000ULL
+#define SM_REGION_SZ    0x8400000ULL
+#define SM_CHUNK        (256u * 1024u)
+
+static uint8_t sm_meta[16384] __attribute__((aligned(16384)));
+static uint8_t sm_buf[SM_CHUNK] __attribute__((aligned(16384)));
+#define SM_WIN          (2u * 1024u * 1024u)
+static vm_offset_t sm_win[SM_REGION_SZ / SM_WIN];
+
+/* map the 2 MiB window holding region offset off (132 MiB at once does not fit the kernel map) */
+static vm_offset_t
+sm_window(uint64_t off)
+{
+	uint64_t i = off / SM_WIN;
+	if (!sm_win[i]) {
+		sm_win[i] = ml_io_map(SM_REGION_PA + i * SM_WIN, SM_WIN);
+	}
+	return sm_win[i] ? sm_win[i] + (off % SM_WIN) : 0;
+}
+
+/* the region is mapped as device memory: aligned 64-bit stores only */
+static int
+sm_copy(uint64_t off, const uint8_t *src, size_t n)
+{
+	while (n) {
+		size_t k = SM_WIN - (off % SM_WIN);
+		vm_offset_t dst = sm_window(off);
+		if (k > n) {
+			k = n;
+		}
+		if (!dst) {
+			return ENOMEM;
+		}
+		size_t i = 0;
+		for (; i + 8 <= k && ((dst + i) & 7) == 0; i += 8) {
+			uint64_t v;
+			memcpy(&v, src + i, 8);
+			*(volatile uint64_t *)(dst + i) = v;
+		}
+		for (; i < k; ++i) {
+			*(volatile uint8_t *)(dst + i) = src[i];
+		}
+		src += k;
+		off += k;
+		n -= k;
+	}
+	return 0;
+}
+
+static int
+sm_zero(uint64_t off, size_t n)
+{
+	while (n) {
+		size_t k = SM_WIN - (off % SM_WIN);
+		vm_offset_t dst = sm_window(off);
+		if (k > n) {
+			k = n;
+		}
+		if (!dst) {
+			return ENOMEM;
+		}
+		size_t i = 0;
+		for (; i < k && ((dst + i) & 7); ++i) {
+			*(volatile uint8_t *)(dst + i) = 0;
+		}
+		for (; i + 8 <= k; i += 8) {
+			*(volatile uint64_t *)(dst + i) = 0;
+		}
+		for (; i < k; ++i) {
+			*(volatile uint8_t *)(dst + i) = 0;
+		}
+		off += k;
+		n -= k;
+	}
+	return 0;
+}
+
+static int
+sm_open(const char *name, vnode_t *vpp)
+{
+	char path[128];
+	snprintf(path, sizeof(path), "%s%s", SM_FW_DIR, name);
+	return vnode_lookup(path, 0, vpp, vfs_context_kernel());
+}
+
+/* read len bytes at file offset off; vp must be looked up */
+static int
+sm_pread(vnode_t vp, void *buf, size_t len, off_t off)
+{
+	int resid = 0;
+	vfs_context_t ctx = vfs_context_kernel();
+	int e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, off, UIO_SYSSPACE, IO_NOAUTH | IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	return e ? e : (resid ? EIO : 0);
+}
+
+static int
+sm_load_segment(const char *name, uint64_t pa, uint64_t filesz, uint64_t memsz)
+{
+	vnode_t vp = NULLVP;
+	int e = sm_open(name, &vp);
+	if (e) {
+		printf("SWEET MODEM: open %s failed %d\n", name, e);
+		return e;
+	}
+	uint64_t dst = pa - SM_REGION_PA;
+	for (uint64_t off = 0; off < filesz; off += SM_CHUNK) {
+		size_t n = (filesz - off) < SM_CHUNK ? (size_t)(filesz - off) : SM_CHUNK;
+		e = sm_pread(vp, sm_buf, n, (off_t)off);
+		if (e) {
+			printf("SWEET MODEM: read %s @%#llx failed %d\n", name, off, e);
+			break;
+		}
+		if (sm_copy(dst + off, sm_buf, n)) {
+			e = ENOMEM;
+			break;
+		}
+	}
+	vnode_put(vp);
+	if (!e && memsz > filesz) {
+		e = sm_zero(dst + filesz, (size_t)(memsz - filesz));
+	}
+	return e;
+}
+
+/*
+ * Legacy SCM call exactly as the Android kernel (scm.c __scm_call_armv8_64) issues it: while TZ answers
+ * x0 == 1 (interrupted) the SMC is repeated with the registers TZ handed back, which resumes the call.
+ * -12 (busy) restarts it after a pause. Standard (non-atomic) calls, as subsys-pil-tz uses.
+ */
+static int sm_std = 1;
+
+static uint64_t
+sm_scm(unsigned svc, unsigned cmd, uint64_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *r1)
+{
+	uint64_t ret = 0, out1 = 0;
+	for (unsigned busy = 0; busy < 70; ++busy) {
+		register uint64_t x0 __asm__("x0") = SM_FID(sm_std ? 0 : 1, svc, cmd);
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = 0;
+		unsigned resumes = 0;
+		do {
+			__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6) : :
+			    "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+			if (resumes < 3) {
+				printf("SWEET MODEM: scm %u/%u -> x0=%#llx x1=%#llx x2=%#llx x3=%#llx\n", svc, cmd, x0, x1, x2, x3);
+			}
+		} while (x0 == 1 && ++resumes < 1000000);
+		ret = x0;
+		out1 = x1;
+		if ((uint32_t)ret != 0xfffffff4u) {
+			break;
+		}
+		touch_wait(30);
+	}
+	if (r1) {
+		*r1 = out1;
+	}
+	return ret;
+}
+
+static int
+sm_boot(void)
+{
+	vnode_t vp = NULLVP;
+	int e = 0;
+	for (unsigned tries = 0; tries < 300; ++tries) {
+		e = sm_open("MODEM.MDT", &vp);
+		if (!e) {
+			break;
+		}
+		touch_wait(2000);
+	}
+	if (e) {
+		printf("SWEET MODEM: no firmware in %s (%d), not booting the modem\n", SM_FW_DIR, e);
+		return e;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	e = vnode_getattr(vp, &va, vfs_context_kernel());
+	size_t mdt = e ? 0 : (size_t)va.va_data_size;
+	if (!mdt || mdt > sizeof(sm_meta) || sm_pread(vp, sm_meta, mdt, 0)) {
+		printf("SWEET MODEM: bad MODEM.MDT (size %zu, e %d)\n", mdt, e);
+		vnode_put(vp);
+		return EINVAL;
+	}
+	vnode_put(vp);
+	/* ELF32 header + program headers */
+	const uint8_t *m = sm_meta;
+	uint32_t phoff, phnum;
+	uint16_t phentsize;
+	memcpy(&phoff, m + 28, 4);
+	memcpy(&phentsize, m + 42, 2);
+	uint16_t pn16;
+	memcpy(&pn16, m + 44, 2);
+	phnum = pn16;
+	if (m[0] != 0x7f || m[4] != 1 || phentsize != 32 || phoff + phnum * 32u > mdt) {
+		printf("SWEET MODEM: unexpected MDT layout\n");
+		return EINVAL;
+	}
+	printf("SWEET MODEM: MDT %zu bytes, %u segments\n", mdt, phnum);
+	uint64_t r1 = 0, r0;
+	/* TZ takes 32-bit buffer addresses: stage the metadata in the last 16 KiB of the modem region (below 4 GiB,
+	 * overwritten by the modem's bss afterwards) */
+	const uint64_t meta_off = SM_REGION_SZ - sizeof(sm_meta);
+	if (sm_copy(meta_off, sm_meta, mdt)) {
+		return ENOMEM;
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+	/* INIT_IMAGE (peripheral, metadata phys): arginfo = 2 args, VAL then RW buffer */
+	r0 = sm_scm(SM_SVC_PIL, 1, 0x2u | (2u << 6), SM_PAS_ID, SM_REGION_PA + meta_off, 0, &r1);
+	printf("SWEET MODEM: INIT_IMAGE meta pa %#llx: x0=%#llx x1=%#llx\n", SM_REGION_PA + meta_off, r0, r1);
+	if (r0 || r1) {
+		return EIO;
+	}
+	/* MEM_SETUP (peripheral, region base, region size) */
+	r0 = sm_scm(SM_SVC_PIL, 2, 0x3u, SM_PAS_ID, SM_REGION_PA, SM_REGION_SZ, &r1);
+	printf("SWEET MODEM: MEM_SETUP: x0=%#llx x1=%#llx\n", r0, r1);
+	if (r0 || r1) {
+		return EIO;
+	}
+	for (uint32_t i = 0; i < phnum; ++i) {
+		uint32_t type, paddr, filesz, memsz, flags;
+		const uint8_t *ph = m + phoff + i * 32u;
+		memcpy(&type, ph, 4);
+		memcpy(&paddr, ph + 12, 4);
+		memcpy(&filesz, ph + 16, 4);
+		memcpy(&memsz, ph + 20, 4);
+		memcpy(&flags, ph + 24, 4);
+		if (type != 1 || !memsz || ((flags >> 24) & 7) == 2) {
+			continue;
+		}
+		if (paddr < SM_REGION_PA || (uint64_t)paddr + memsz > SM_REGION_PA + SM_REGION_SZ) {
+			printf("SWEET MODEM: segment %u outside the region\n", i);
+			return EINVAL;
+		}
+		char name[16];
+		snprintf(name, sizeof(name), "MODEM.B%02u", i);
+		if (filesz && sm_load_segment(name, paddr, filesz, memsz)) {
+			return EIO;
+		}
+		if (!filesz) {
+			if (sm_zero(paddr - SM_REGION_PA, memsz)) {
+				return ENOMEM;
+			}
+		}
+	}
+	printf("SWEET MODEM: segments loaded, AUTH_AND_RESET\n");
+	__asm__ volatile("dsb sy" : : : "memory");
+	r0 = sm_scm(SM_SVC_PIL, 5, 0x1u, SM_PAS_ID, 0, 0, &r1);
+	printf("SWEET MODEM: AUTH_AND_RESET: x0=%#llx x1=%#llx\n", r0, r1);
+	return r0 || r1 ? EIO : 0;
+}
+
 static void
 sm_thread(void *arg, wait_result_t result)
 {
@@ -61,13 +334,22 @@ sm_thread(void *arg, wait_result_t result)
 	(void)result;
 	touch_wait(70 * 1000u);
 	sm_probe();
+	int boot = 1;
+	(void)PE_parse_boot_argn("sweetmodemstd", &sm_std, sizeof(sm_std));
+	(void)PE_parse_boot_argn("sweetmodemboot", &boot, sizeof(boot));
+	if (boot) {
+		printf("SWEET MODEM: boot result %d\n", sm_boot());
+	}
 	(void)thread_terminate(current_thread());
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
