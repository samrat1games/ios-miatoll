diff --git a/bsd/dev/sweet_modem.inc b/bsd/dev/sweet_modem.inc
index 51c3fd6..73c540e 100644
--- a/bsd/dev/sweet_modem.inc
+++ b/bsd/dev/sweet_modem.inc
@@ -4,6 +4,13 @@
  * peripheral-image-loader (PIL, svc 2) calls the Linux subsys-pil-tz driver uses for the modem (pas-id 4)?
  * Boot-arg sweetmodem=0 disables the probe.
  */
+#include <sys/vnode_internal.h>
+#include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include <sys/namei.h>
+#include <vm/pmap.h>
+#include <mach/vm_param.h>
+
 #define SM_SVC_INFO     0x6u
 #define SM_SVC_PIL      0x2u
 #define SM_INFO_AVAIL   0x1u
@@ -54,20 +61,1460 @@ sm_probe(void)
 	}
 }
 
+/*
+ * Step 2: peripheral image loader for the modem (pas-id 4), the same sequence subsys-pil-tz runs on Android:
+ * INIT_IMAGE(metadata = MODEM.MDT) -> MEM_SETUP(region) -> copy the ELF segments (MODEM.Bnn) into the
+ * reserved modem region -> AUTH_AND_RESET. Firmware files come from the root file system (SM_FW_DIR),
+ * copied there from the "modem" partition (tools/fat16-ls.py).
+ */
+#define SM_PAS_ID       4u
+#define SM_FW_DIR       "/private/var/miatoll/modem/"
+#define SM_REGION_PA    0x86000000ULL
+#define SM_REGION_SZ    0x8400000ULL
+#define SM_CHUNK        (256u * 1024u)
+
+static uint8_t sm_meta[16384] __attribute__((aligned(16384)));
+static uint8_t sm_buf[SM_CHUNK] __attribute__((aligned(16384)));
+#define SM_WIN          (2u * 1024u * 1024u)
+
+/* The kernel map has no room for 132 MiB of device mappings: one 2 MiB window, re-pointed with pmap_map_bd
+ * (device memory attributes) at whichever part of the modem region is being written. */
+extern uint64_t sm_pmap_map_bd(uint64_t va, uint64_t start, uint64_t end, int prot) __asm__("_pmap_map_bd");
+static vm_offset_t sm_win_va;
+static int64_t sm_win_idx = -1;
+
+static vm_offset_t
+sm_window(uint64_t off)
+{
+	int64_t i = (int64_t)(off / SM_WIN);
+	if (!sm_win_va) {
+		sm_win_va = ml_io_map(SM_REGION_PA, SM_WIN);
+		if (!sm_win_va) {
+			return 0;
+		}
+		sm_win_idx = 0;
+	}
+	if (sm_win_idx != i) {
+		uint64_t pa = SM_REGION_PA + (uint64_t)i * SM_WIN;
+		sm_pmap_map_bd(sm_win_va, pa, pa + SM_WIN, VM_PROT_READ | VM_PROT_WRITE);
+		__asm__ volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" : : : "memory");
+		sm_win_idx = i;
+	}
+	return sm_win_va + (off % SM_WIN);
+}
+
+/* the region is mapped as device memory: aligned 64-bit stores only */
+static int
+sm_copy(uint64_t off, const uint8_t *src, size_t n)
+{
+	while (n) {
+		size_t k = SM_WIN - (off % SM_WIN);
+		vm_offset_t dst = sm_window(off);
+		if (k > n) {
+			k = n;
+		}
+		if (!dst) {
+			return ENOMEM;
+		}
+		size_t i = 0;
+		for (; i + 8 <= k && ((dst + i) & 7) == 0; i += 8) {
+			uint64_t v;
+			memcpy(&v, src + i, 8);
+			*(volatile uint64_t *)(dst + i) = v;
+		}
+		for (; i < k; ++i) {
+			*(volatile uint8_t *)(dst + i) = src[i];
+		}
+		src += k;
+		off += k;
+		n -= k;
+	}
+	return 0;
+}
+
+static int
+sm_zero(uint64_t off, size_t n)
+{
+	while (n) {
+		size_t k = SM_WIN - (off % SM_WIN);
+		vm_offset_t dst = sm_window(off);
+		if (k > n) {
+			k = n;
+		}
+		if (!dst) {
+			return ENOMEM;
+		}
+		size_t i = 0;
+		for (; i < k && ((dst + i) & 7); ++i) {
+			*(volatile uint8_t *)(dst + i) = 0;
+		}
+		for (; i + 8 <= k; i += 8) {
+			*(volatile uint64_t *)(dst + i) = 0;
+		}
+		for (; i < k; ++i) {
+			*(volatile uint8_t *)(dst + i) = 0;
+		}
+		off += k;
+		n -= k;
+	}
+	return 0;
+}
+
+static int
+sm_open(const char *name, vnode_t *vpp)
+{
+	char path[128];
+	snprintf(path, sizeof(path), "%s%s", SM_FW_DIR, name);
+	return vnode_lookup(path, 0, vpp, vfs_context_kernel());
+}
+
+/* read len bytes at file offset off; vp must be looked up */
+static int
+sm_pread(vnode_t vp, void *buf, size_t len, off_t off)
+{
+	int resid = 0;
+	vfs_context_t ctx = vfs_context_kernel();
+	int e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, off, UIO_SYSSPACE, IO_NOAUTH | IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	return e ? e : (resid ? EIO : 0);
+}
+
+static int
+sm_load_segment(const char *name, uint64_t pa, uint64_t filesz, uint64_t memsz)
+{
+	vnode_t vp = NULLVP;
+	int e = sm_open(name, &vp);
+	if (e) {
+		printf("SWEET MODEM: open %s failed %d\n", name, e);
+		return e;
+	}
+	uint64_t dst = pa - SM_REGION_PA;
+	for (uint64_t off = 0; off < filesz; off += SM_CHUNK) {
+		size_t n = (filesz - off) < SM_CHUNK ? (size_t)(filesz - off) : SM_CHUNK;
+		e = sm_pread(vp, sm_buf, n, (off_t)off);
+		if (e) {
+			printf("SWEET MODEM: read %s @%#llx failed %d\n", name, off, e);
+			break;
+		}
+		if (sm_copy(dst + off, sm_buf, n)) {
+			e = ENOMEM;
+			break;
+		}
+	}
+	vnode_put(vp);
+	if (!e && memsz > filesz) {
+		e = sm_zero(dst + filesz, (size_t)(memsz - filesz));
+	}
+	return e;
+}
+
+/*
+ * Legacy SCM call exactly as the Android kernel (scm.c __scm_call_armv8_64) issues it: while TZ answers
+ * x0 == 1 (interrupted) the SMC is repeated with the registers TZ handed back, which resumes the call.
+ * -12 (busy) restarts it after a pause. Standard (non-atomic) calls, as subsys-pil-tz uses.
+ */
+static int sm_std = 1;
+
+static uint64_t
+sm_scm(unsigned svc, unsigned cmd, uint64_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *r1)
+{
+	uint64_t ret = 0, out1 = 0;
+	for (unsigned busy = 0; busy < 70; ++busy) {
+		register uint64_t x0 __asm__("x0") = SM_FID(sm_std ? 0 : 1, svc, cmd);
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = 0;
+		unsigned resumes = 0;
+		do {
+			__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6) : :
+			    "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+			if (resumes < 3) {
+				printf("SWEET MODEM: scm %u/%u -> x0=%#llx x1=%#llx x2=%#llx x3=%#llx\n", svc, cmd, x0, x1, x2, x3);
+			}
+		} while (x0 == 1 && ++resumes < 1000000);
+		ret = x0;
+		out1 = x1;
+		if ((uint32_t)ret != 0xfffffff4u) {
+			break;
+		}
+		touch_wait(30);
+	}
+	if (r1) {
+		*r1 = out1;
+	}
+	return ret;
+}
+
+static int
+sm_boot(void)
+{
+	vnode_t vp = NULLVP;
+	int e = 0;
+	for (unsigned tries = 0; tries < 300; ++tries) {
+		e = sm_open("MODEM.MDT", &vp);
+		if (!e) {
+			break;
+		}
+		touch_wait(2000);
+	}
+	if (e) {
+		printf("SWEET MODEM: no firmware in %s (%d), not booting the modem\n", SM_FW_DIR, e);
+		return e;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	e = vnode_getattr(vp, &va, vfs_context_kernel());
+	size_t mdt = e ? 0 : (size_t)va.va_data_size;
+	if (!mdt || mdt > sizeof(sm_meta) || sm_pread(vp, sm_meta, mdt, 0)) {
+		printf("SWEET MODEM: bad MODEM.MDT (size %zu, e %d)\n", mdt, e);
+		vnode_put(vp);
+		return EINVAL;
+	}
+	vnode_put(vp);
+	/* ELF32 header + program headers */
+	const uint8_t *m = sm_meta;
+	uint32_t phoff, phnum;
+	uint16_t phentsize;
+	memcpy(&phoff, m + 28, 4);
+	memcpy(&phentsize, m + 42, 2);
+	uint16_t pn16;
+	memcpy(&pn16, m + 44, 2);
+	phnum = pn16;
+	if (m[0] != 0x7f || m[4] != 1 || phentsize != 32 || phoff + phnum * 32u > mdt) {
+		printf("SWEET MODEM: unexpected MDT layout\n");
+		return EINVAL;
+	}
+	printf("SWEET MODEM: MDT %zu bytes, %u segments\n", mdt, phnum);
+	uint64_t r1 = 0, r0;
+	/* TZ takes 32-bit buffer addresses: stage the metadata in the last 16 KiB of the modem region (below 4 GiB,
+	 * overwritten by the modem's bss afterwards) */
+	const uint64_t meta_off = SM_REGION_SZ - sizeof(sm_meta);
+	if (sm_copy(meta_off, sm_meta, mdt)) {
+		return ENOMEM;
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+	/* INIT_IMAGE (peripheral, metadata phys): arginfo = 2 args, VAL then RW buffer */
+	r0 = sm_scm(SM_SVC_PIL, 1, 0x2u | (2u << 6), SM_PAS_ID, SM_REGION_PA + meta_off, 0, &r1);
+	printf("SWEET MODEM: INIT_IMAGE meta pa %#llx: x0=%#llx x1=%#llx\n", SM_REGION_PA + meta_off, r0, r1);
+	if (r0 || r1) {
+		return EIO;
+	}
+	/* MEM_SETUP (peripheral, region base, region size) */
+	r0 = sm_scm(SM_SVC_PIL, 2, 0x3u, SM_PAS_ID, SM_REGION_PA, SM_REGION_SZ, &r1);
+	printf("SWEET MODEM: MEM_SETUP: x0=%#llx x1=%#llx\n", r0, r1);
+	if (r0 || r1) {
+		return EIO;
+	}
+	for (uint32_t i = 0; i < phnum; ++i) {
+		uint32_t type, paddr, filesz, memsz, flags;
+		const uint8_t *ph = m + phoff + i * 32u;
+		memcpy(&type, ph, 4);
+		memcpy(&paddr, ph + 12, 4);
+		memcpy(&filesz, ph + 16, 4);
+		memcpy(&memsz, ph + 20, 4);
+		memcpy(&flags, ph + 24, 4);
+		if (type != 1 || !memsz || ((flags >> 24) & 7) == 2) {
+			continue;
+		}
+		if (paddr < SM_REGION_PA || (uint64_t)paddr + memsz > SM_REGION_PA + SM_REGION_SZ) {
+			printf("SWEET MODEM: segment %u outside the region\n", i);
+			return EINVAL;
+		}
+		char name[16];
+		snprintf(name, sizeof(name), "MODEM.B%02u", i);
+		if (filesz && sm_load_segment(name, paddr, filesz, memsz)) {
+			return EIO;
+		}
+		if (!filesz) {
+			if (sm_zero(paddr - SM_REGION_PA, memsz)) {
+				return ENOMEM;
+			}
+		}
+	}
+	printf("SWEET MODEM: segments loaded, AUTH_AND_RESET\n");
+	__asm__ volatile("dsb sy" : : : "memory");
+	r0 = sm_scm(SM_SVC_PIL, 5, 0x1u, SM_PAS_ID, 0, 0, &r1);
+	printf("SWEET MODEM: AUTH_AND_RESET: x0=%#llx x1=%#llx\n", r0, r1);
+	return r0 || r1 ? EIO : 0;
+}
+
+/*
+ * Step 3: is the modem alive? Its SMP2P item (magic "$SMP") appears in shared memory (SMEM, 0x80900000) once the
+ * modem OS is running. Polled; no interrupts are wired yet.
+ */
+#define SM_SMEM_PA      0x80900000ULL
+#define SM_SMEM_SZ      0x200000u
+#define SM_SMP2P_MAGIC  0x504d5324u
+
+/*
+ * SMEM (Qualcomm shared memory): partition table at the end of the region ("$TOC"), one partition per host
+ * pair. Only partitions that involve the application processor (host 0) may be touched: reading the others
+ * hangs the CPU (bus error from the memory protection unit).
+ */
+#define SM_TOC_MAGIC    0x434f5424u     /* "$TOC" */
+#define SM_PRT_MAGIC    0x54525024u     /* "$PRT" */
+#define SM_PRIV_CANARY  0xa5a5u
+#define SM_HOST_GLOBAL  0xfffeu
+
+static vm_offset_t sm_smem;
+
+static inline uint32_t
+sm_r32(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline uint16_t
+sm_r16(vm_offset_t a)
+{
+	return *(volatile uint16_t *)a;
+}
+
+/* find item `item` in the partition shared by the AP and `remote`; returns its address (0 if absent) */
+static vm_offset_t
+sm_smem_item(uint16_t remote, uint32_t item, uint32_t *sizep)
+{
+	vm_offset_t toc = sm_smem + SM_SMEM_SZ - 0x1000;
+	if (sm_r32(toc) != SM_TOC_MAGIC) {
+		return 0;
+	}
+	uint32_t n = sm_r32(toc + 8);
+	for (uint32_t i = 0; i < n && i < 32; ++i) {
+		vm_offset_t e = toc + 0x20 + 48 * i;
+		uint32_t off = sm_r32(e), size = sm_r32(e + 4);
+		uint16_t h0 = sm_r16(e + 12), h1 = sm_r16(e + 14);
+		if (!size || !((h0 == 0 && h1 == remote) || (h1 == 0 && h0 == remote))) {
+			continue;
+		}
+		vm_offset_t part = sm_smem + off;
+		if (sm_r32(part) != SM_PRT_MAGIC) {
+			return 0;
+		}
+		vm_offset_t p = part + 0x20, end = part + sm_r32(part + 8 + 4 /* offset_free_uncached */);
+		while (p + 16 <= end && sm_r16(p) == SM_PRIV_CANARY) {
+			uint32_t isz = sm_r32(p + 4);
+			uint16_t pad_data = sm_r16(p + 8), pad_hdr = sm_r16(p + 10);
+			if (sm_r16(p + 2) == item) {
+				if (sizep) {
+					*sizep = isz - pad_data;
+				}
+				return p + 16 + pad_hdr;
+			}
+			p += 16 + pad_hdr + isz;
+		}
+	}
+	return 0;
+}
+
+static void
+sm_smem_dump(void)
+{
+	vm_offset_t toc = sm_smem + SM_SMEM_SZ - 0x1000;
+	printf("SWEET MODEM: toc magic %#x version %#x entries %u\n", sm_r32(toc), sm_r32(toc + 4), sm_r32(toc + 8));
+	if (sm_r32(toc) != SM_TOC_MAGIC) {
+		return;
+	}
+	uint32_t n = sm_r32(toc + 8);
+	for (uint32_t i = 0; i < n && i < 32; ++i) {
+		vm_offset_t e = toc + 0x20 + 48 * i;
+		uint32_t off = sm_r32(e), size = sm_r32(e + 4);
+		uint16_t h0 = sm_r16(e + 12), h1 = sm_r16(e + 14);
+		printf("SWEET MODEM: partition %u: off %#x size %#x hosts %#x/%#x\n", i, off, size, h0, h1);
+		if (!size || !(h0 == 0 || h1 == 0)) {
+			continue;
+		}
+		vm_offset_t part = sm_smem + off;
+		printf("SWEET MODEM:   header magic %#x free_uncached %#x free_cached %#x\n", sm_r32(part), sm_r32(part + 12),
+		    sm_r32(part + 16));
+		if (sm_r32(part) != SM_PRT_MAGIC) {
+			continue;
+		}
+		vm_offset_t p = part + 0x20, end = part + sm_r32(part + 12);
+		unsigned count = 0;
+		while (p + 16 <= end && sm_r16(p) == SM_PRIV_CANARY && count++ < 64) {
+			uint32_t isz = sm_r32(p + 4);
+			uint16_t pad_hdr = sm_r16(p + 10);
+			printf("SWEET MODEM:   item %u size %#x\n", sm_r16(p + 2), isz);
+			p += 16 + pad_hdr + isz;
+		}
+	}
+}
+
+static inline void
+sm_w32(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+static inline void
+sm_w16(vm_offset_t a, uint16_t v)
+{
+	*(volatile uint16_t *)a = v;
+}
+
+/* partition shared by the AP and `remote`, 0 if none */
+static vm_offset_t
+sm_smem_partition(uint16_t remote)
+{
+	vm_offset_t toc = sm_smem + SM_SMEM_SZ - 0x1000;
+	if (sm_r32(toc) != SM_TOC_MAGIC) {
+		return 0;
+	}
+	uint32_t n = sm_r32(toc + 8);
+	for (uint32_t i = 0; i < n && i < 32; ++i) {
+		vm_offset_t e = toc + 0x20 + 48 * i;
+		uint16_t h0 = sm_r16(e + 12), h1 = sm_r16(e + 14);
+		if (sm_r32(e + 4) && ((h0 == 0 && h1 == remote) || (h1 == 0 && h0 == remote))) {
+			return sm_smem + sm_r32(e);
+		}
+	}
+	return 0;
+}
+
+/* allocate an item (zeroed by the caller) at the end of the uncached area; no hardware lock (single writer here) */
+static vm_offset_t
+sm_smem_alloc(uint16_t remote, uint32_t item, uint32_t size)
+{
+	vm_offset_t part = sm_smem_partition(remote);
+	if (!part || sm_r32(part) != SM_PRT_MAGIC) {
+		return 0;
+	}
+	uint32_t asz = (size + 7) & ~7u;
+	uint32_t freeoff = sm_r32(part + 12);
+	if (freeoff + 16 + asz > sm_r32(part + 16)) {
+		return 0;
+	}
+	vm_offset_t p = part + freeoff;
+	sm_w16(p, SM_PRIV_CANARY);
+	sm_w16(p + 2, (uint16_t)item);
+	sm_w32(p + 4, asz);
+	sm_w16(p + 8, (uint16_t)(asz - size));
+	sm_w16(p + 10, 0);
+	sm_w32(p + 12, 0);
+	for (uint32_t i = 0; i < asz; i += 4) {
+		sm_w32(p + 16 + i, 0);
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+	sm_w32(part + 12, freeoff + 16 + asz);
+	__asm__ volatile("dsb sy" : : : "memory");
+	return p + 16;
+}
+
+/* ---- SMP2P (see Linux drivers/soc/qcom/smp2p.c): item 435 modem->AP, 428 AP->modem ---- */
+#define SM_APCS_PA      0x17c00000ULL
+#define SM_APCS_IPC     0x0cu
+#define SM_IPC_SMP2P    14u
+#define SM_IPC_GLINK    12u
+#define SM_SMP2P_IN     435u
+#define SM_SMP2P_OUT    428u
+
+static vm_offset_t sm_apcs;
+
+static void
+sm_kick(unsigned bit)
+{
+	if (sm_apcs) {
+		__asm__ volatile("dsb sy" : : : "memory");
+		sm_w32(sm_apcs + SM_APCS_IPC, 1u << bit);
+	}
+}
+
+static vm_offset_t sm_p2p_out, sm_p2p_in;
+
+static void
+sm_smp2p_setup(void)
+{
+	sm_p2p_out = sm_smem_item(1, SM_SMP2P_OUT, NULL);
+	if (!sm_p2p_out) {
+		sm_p2p_out = sm_smem_alloc(1, SM_SMP2P_OUT, 340);
+		if (!sm_p2p_out) {
+			printf("SWEET MODEM: smp2p out item alloc failed\n");
+			return;
+		}
+		sm_w32(sm_p2p_out, 0x504d5324u);
+		sm_w32(sm_p2p_out + 4, 1u << 8);                    /* features = SSR_ACK, version 0 (not yet valid) */
+		sm_w16(sm_p2p_out + 8, 0);                          /* local pid */
+		sm_w16(sm_p2p_out + 10, 1);                         /* remote pid */
+		sm_w16(sm_p2p_out + 12, 16);                        /* total entries */
+		sm_w16(sm_p2p_out + 14, 1);                         /* valid entries: master-kernel */
+		static const char nm[16] = "master-kernel";
+		for (int i = 0; i < 16; i += 4) {
+			uint32_t w;
+			memcpy(&w, nm + i, 4);
+			sm_w32(sm_p2p_out + 20 + i, w);
+		}
+		__asm__ volatile("dsb sy" : : : "memory");
+		sm_w32(sm_p2p_out + 4, 1u | (1u << 8));             /* version 1 validates the item */
+		printf("SWEET MODEM: smp2p out item created at smem+%#lx\n", (unsigned long)(sm_p2p_out - sm_smem));
+	}
+	sm_kick(SM_IPC_SMP2P);
+}
+
+static void
+sm_smp2p_poll(void)
+{
+	if (!sm_p2p_in) {
+		sm_p2p_in = sm_smem_item(1, SM_SMP2P_IN, NULL);
+		if (sm_p2p_in) {
+			printf("SWEET MODEM: smp2p in item at smem+%#lx magic %#x\n", (unsigned long)(sm_p2p_in - sm_smem), sm_r32(sm_p2p_in));
+		}
+	}
+	if (!sm_p2p_in) {
+		return;
+	}
+	static uint32_t last[16];
+	static uint32_t last_hdr[3];
+	uint32_t hdr[3] = {sm_r32(sm_p2p_in + 4), sm_r32(sm_p2p_in + 12), sm_r32(sm_p2p_in + 16)};
+	if (memcmp(hdr, last_hdr, sizeof(hdr))) {
+		memcpy(last_hdr, hdr, sizeof(hdr));
+		printf("SWEET MODEM: smp2p in: ver/feat %#x total/valid %#x flags %#x\n", hdr[0], hdr[1], hdr[2]);
+		/* negotiation: both sides on version 1; acknowledge a modem restart */
+		if ((hdr[0] & 0xff) == 1 && (hdr[2] & 1)) {
+			sm_w32(sm_p2p_out + 16, sm_r32(sm_p2p_out + 16) | 2u);
+		}
+		sm_kick(SM_IPC_SMP2P);
+	}
+	uint32_t valid = (hdr[1] >> 16) & 0xffff;
+	for (uint32_t e = 0; e < valid && e < 16; ++e) {
+		uint32_t v = sm_r32(sm_p2p_in + 20 + 20 * e + 16);
+		if (v != last[e]) {
+			char name[17];
+			for (int c = 0; c < 16; ++c) {
+				name[c] = *(volatile uint8_t *)(sm_p2p_in + 20 + 20 * e + c);
+			}
+			name[16] = 0;
+			last[e] = v;
+			printf("SWEET MODEM: smp2p in '%s' = %#x\n", name, v);
+		}
+	}
+}
+
+
+/* ---------------- GLINK over SMEM (polled), Linux qcom_glink_smem.c / qcom_glink_native.c ---------------- */
+#define GL_DESC_ITEM    478u
+#define GL_FIFO0_ITEM   479u    /* AP -> modem */
+#define GL_FIFO1_ITEM   480u    /* modem -> AP */
+#define GL_VERSION      1u
+#define GL_FEATURES     1u      /* INTENT_REUSE */
+#define GC_VERSION      0
+#define GC_VERSION_ACK  1
+#define GC_OPEN         2
+#define GC_CLOSE        3
+#define GC_OPEN_ACK     4
+#define GC_INTENT       5
+#define GC_RX_DONE      6
+#define GC_RX_INTENT_REQ 7
+#define GC_RX_INTENT_REQ_ACK 8
+#define GC_TX_DATA      9
+#define GC_CLOSE_ACK    11
+#define GC_TX_DATA_CONT 12
+#define GC_READ_NOTIF   13
+#define GC_RX_DONE_W_REUSE 14
+
+static vm_offset_t gl_desc, gl_txf, gl_rxf;
+static uint32_t gl_txlen, gl_rxlen, gl_features = GL_FEATURES;
+static int gl_ready;
+
+#define GL_TX_TAIL (gl_desc + 0)
+#define GL_TX_HEAD (gl_desc + 4)
+#define GL_RX_TAIL (gl_desc + 8)
+#define GL_RX_HEAD (gl_desc + 12)
+
+static uint32_t
+gl_rx_avail(void)
+{
+	uint32_t head = sm_r32(GL_RX_HEAD), tail = sm_r32(GL_RX_TAIL);
+	return head < tail ? gl_rxlen - tail + head : head - tail;
+}
+
+static void
+gl_rx_peek(void *dst, uint32_t off, uint32_t n)
+{
+	uint32_t tail = sm_r32(GL_RX_TAIL) + off;
+	if (tail >= gl_rxlen) {
+		tail -= gl_rxlen;
+	}
+	uint32_t first = gl_rxlen - tail < n ? gl_rxlen - tail : n;
+	uint8_t *d = dst;
+	for (uint32_t i = 0; i < first; ++i) {
+		d[i] = *(volatile uint8_t *)(gl_rxf + tail + i);
+	}
+	for (uint32_t i = first; i < n; ++i) {
+		d[i] = *(volatile uint8_t *)(gl_rxf + i - first);
+	}
+}
+
+static void
+gl_rx_advance(uint32_t n)
+{
+	uint32_t tail = sm_r32(GL_RX_TAIL) + n;
+	if (tail >= gl_rxlen) {
+		tail -= gl_rxlen;
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+	sm_w32(GL_RX_TAIL, tail);
+}
+
+static int
+gl_tx(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+	uint32_t head = sm_r32(GL_TX_HEAD), tail = sm_r32(GL_TX_TAIL);
+	uint32_t avail = tail <= head ? gl_txlen - head + tail : tail - head;
+	uint32_t total = (hlen + dlen + 7) & ~7u;
+	if (avail < total + 32) {
+		return EBUSY;
+	}
+	const uint8_t *parts[2] = {hdr, data};
+	uint32_t lens[2] = {hlen, dlen};
+	for (int k = 0; k < 2; ++k) {
+		for (uint32_t i = 0; i < lens[k]; ++i) {
+			*(volatile uint8_t *)(gl_txf + head) = parts[k][i];
+			if (++head >= gl_txlen) {
+				head = 0;
+			}
+		}
+	}
+	while (head & 7) {
+		*(volatile uint8_t *)(gl_txf + head) = 0;
+		if (++head >= gl_txlen) {
+			head = 0;
+		}
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+	sm_w32(GL_TX_HEAD, head);
+	sm_kick(SM_IPC_GLINK);
+	static unsigned txlog;
+	if (txlog++ < 30) {
+		printf("SWEET GLINK: tx %u bytes, head -> %u (tail %u) cmd %u\n", hlen + dlen, head, sm_r32(GL_TX_TAIL),
+		    *(const uint16_t *)hdr);
+	}
+	return 0;
+}
+
+static int
+gl_msg(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint8_t m[8];
+	memcpy(m, &cmd, 2);
+	memcpy(m + 2, &p1, 2);
+	memcpy(m + 4, &p2, 4);
+	return gl_tx(m, 8, NULL, 0);
+}
+
+static int
+gl_setup(void)
+{
+	uint32_t size = 0;
+	gl_desc = sm_smem_item(1, GL_DESC_ITEM, &size);
+	if (!gl_desc || size != 32) {
+		printf("SWEET GLINK: descriptor missing (item %#lx size %u)\n", (unsigned long)gl_desc, size);
+		return ENOENT;
+	}
+	gl_txf = sm_smem_item(1, GL_FIFO0_ITEM, &gl_txlen);
+	if (!gl_txf) {
+		gl_txf = sm_smem_alloc(1, GL_FIFO0_ITEM, 16384);
+		gl_txlen = 16384;
+	}
+	gl_rxf = sm_smem_item(1, GL_FIFO1_ITEM, &gl_rxlen);
+	if (!gl_txf || !gl_rxf) {
+		printf("SWEET GLINK: fifos missing tx %#lx rx %#lx\n", (unsigned long)gl_txf, (unsigned long)gl_rxf);
+		return ENOENT;
+	}
+	sm_w32(GL_RX_TAIL, 0);
+	sm_w32(GL_TX_HEAD, 0);
+	printf("SWEET GLINK: tx fifo %u rx fifo %u; desc %#x %#x %#x %#x\n", gl_txlen, gl_rxlen, sm_r32(GL_TX_TAIL),
+	    sm_r32(GL_TX_HEAD), sm_r32(GL_RX_TAIL), sm_r32(GL_RX_HEAD));
+	struct { uint16_t cmd, v; uint32_t f; } vm = {GC_VERSION, GL_VERSION, gl_features};
+	gl_tx(&vm, 8, NULL, 0);
+	return 0;
+}
+
+/* one channel of interest: IPCRTR (QRTR) */
+#define GL_LCID         5u
+static uint32_t gl_rcid, gl_open_remote, gl_open_local, gl_next_iid = 1;
+static struct { uint32_t id, size; int used; } gl_rintent[8];
+static int gl_nrint;
+static uint8_t gl_msgbuf[8192];
+static uint32_t gl_msglen;
+
+static void qrtr_rx(const uint8_t *pkt, uint32_t len);
+
+static void
+gl_advertise(void)
+{
+	uint8_t m[16];
+	uint16_t cmd = GC_INTENT, l = (uint16_t)GL_LCID;
+	uint32_t count = 1, size = 4096, iid = gl_next_iid++;
+	memcpy(m, &cmd, 2);
+	memcpy(m + 2, &l, 2);
+	memcpy(m + 4, &count, 4);
+	memcpy(m + 8, &size, 4);
+	memcpy(m + 12, &iid, 4);
+	gl_tx(m, 16, NULL, 0);
+}
+
+static void
+gl_open_ours(void)
+{
+	uint8_t m[16] = {0};
+	uint16_t cmd = GC_OPEN, l = (uint16_t)GL_LCID;
+	uint32_t nlen = 7;
+	memcpy(m, &cmd, 2);
+	memcpy(m + 2, &l, 2);
+	memcpy(m + 4, &nlen, 4);
+	memcpy(m + 8, "IPCRTR", 7);
+	gl_tx(m, 16, NULL, 0);
+}
+
+/* send one packet on IPCRTR using one of the modem's advertised intents */
+static int
+gl_send(const void *data, uint32_t len)
+{
+	for (int i = 0; i < gl_nrint; ++i) {
+		if (!gl_rintent[i].used && gl_rintent[i].size >= len) {
+			gl_rintent[i].used = 1;
+			uint8_t h[16];
+			uint16_t cmd = GC_TX_DATA, l = (uint16_t)GL_LCID;
+			uint32_t iid = gl_rintent[i].id, chunk = len, left = 0;
+			memcpy(h, &cmd, 2);
+			memcpy(h + 2, &l, 2);
+			memcpy(h + 4, &iid, 4);
+			memcpy(h + 8, &chunk, 4);
+			memcpy(h + 12, &left, 4);
+			return gl_tx(h, 16, data, len);
+		}
+	}
+	gl_msg(GC_RX_INTENT_REQ, (uint16_t)GL_LCID, 4096);
+	return EAGAIN;
+}
+
+static void
+gl_poll(void)
+{
+	for (unsigned guard = 0; guard < 64 && gl_rx_avail() >= 8; ++guard) {
+		uint8_t h[8];
+		gl_rx_peek(h, 0, 8);
+		uint16_t cmd, p1;
+		uint32_t p2;
+		memcpy(&cmd, h, 2);
+		memcpy(&p1, h + 2, 2);
+		memcpy(&p2, h + 4, 4);
+		uint32_t avail = gl_rx_avail();
+		switch (cmd) {
+		case GC_VERSION:
+			printf("SWEET GLINK: rx VERSION %u features %#x\n", p1, p2);
+			gl_features &= p2;
+			{
+				struct { uint16_t cmd, v; uint32_t f; } a = {GC_VERSION_ACK, GL_VERSION, gl_features};
+				gl_tx(&a, 8, NULL, 0);
+			}
+			gl_rx_advance(8);
+			break;
+		case GC_VERSION_ACK:
+			printf("SWEET GLINK: rx VERSION_ACK %u features %#x\n", p1, p2);
+			if (p2 != gl_features) {
+				gl_features &= p2;
+				struct { uint16_t cmd, v; uint32_t f; } a = {GC_VERSION, GL_VERSION, gl_features};
+				gl_tx(&a, 8, NULL, 0);
+			} else {
+				gl_ready = 1;
+			}
+			gl_rx_advance(8);
+			break;
+		case GC_OPEN: {
+			uint32_t total = (8 + p2 + 7) & ~7u;
+			if (avail < total) {
+				return;
+			}
+			char name[32] = {0};
+			gl_rx_peek(name, 8, p2 < 31 ? p2 : 31);
+			printf("SWEET GLINK: rx OPEN rcid %u '%s'\n", p1, name);
+			gl_rx_advance(total);
+			gl_msg(GC_OPEN_ACK, p1, 0);
+			if (!strcmp(name, "IPCRTR")) {
+				gl_rcid = p1;
+				gl_open_remote = 1;
+				if (!gl_open_local) {
+					gl_open_ours();
+				}
+			}
+			break;
+		}
+		case GC_OPEN_ACK:
+			printf("SWEET GLINK: rx OPEN_ACK lcid %u\n", p1);
+			gl_rx_advance(8);
+			if (p1 == GL_LCID) {
+				gl_open_local = 1;
+				gl_advertise();
+				gl_advertise();
+			}
+			break;
+		case GC_INTENT: {
+			uint32_t total = (8 + 8 * p2 + 7) & ~7u;
+			if (avail < total) {
+				return;
+			}
+			for (uint32_t i = 0; i < p2; ++i) {
+				uint32_t sz, id;
+				gl_rx_peek(&sz, 8 + 8 * i, 4);
+				gl_rx_peek(&id, 12 + 8 * i, 4);
+				if (gl_nrint < 8) {
+					gl_rintent[gl_nrint].id = id;
+					gl_rintent[gl_nrint].size = sz;
+					gl_rintent[gl_nrint].used = 0;
+					gl_nrint++;
+				}
+				printf("SWEET GLINK: rx INTENT rcid %u id %u size %u\n", p1, id, sz);
+			}
+			gl_rx_advance(total);
+			break;
+		}
+		case GC_RX_DONE:
+		case GC_RX_DONE_W_REUSE:
+			printf("SWEET GLINK: rx RX_DONE(%u) cid %u iid %u\n", cmd, p1, p2);
+			for (int i = 0; i < gl_nrint; ++i) {
+				if (gl_rintent[i].id == p2) {
+					gl_rintent[i].used = 0;
+				}
+			}
+			gl_rx_advance(8);
+			break;
+		case GC_RX_INTENT_REQ:
+			gl_rx_advance(8);
+			gl_msg(GC_RX_INTENT_REQ_ACK, (uint16_t)GL_LCID, 1);
+			gl_advertise();
+			break;
+		case GC_RX_INTENT_REQ_ACK:
+		case GC_READ_NOTIF:
+		case GC_CLOSE_ACK:
+			gl_rx_advance(8);
+			break;
+		case GC_CLOSE:
+			printf("SWEET GLINK: rx CLOSE rcid %u\n", p1);
+			gl_rx_advance(8);
+			gl_msg(GC_CLOSE_ACK, p1, 0);
+			break;
+		case GC_TX_DATA:
+		case GC_TX_DATA_CONT: {
+			if (avail < 16) {
+				return;
+			}
+			uint32_t chunk, left;
+			gl_rx_peek(&chunk, 8, 4);
+			gl_rx_peek(&left, 12, 4);
+			uint32_t total = (16 + chunk + 7) & ~7u;
+			if (avail < total) {
+				return;
+			}
+			if (cmd == GC_TX_DATA) {
+				gl_msglen = 0;
+			}
+			if (gl_msglen + chunk <= sizeof(gl_msgbuf)) {
+				gl_rx_peek(gl_msgbuf + gl_msglen, 16, chunk);
+				gl_msglen += chunk;
+			}
+			gl_rx_advance(total);
+			if (left == 0) {
+				gl_msg(GC_RX_DONE, (uint16_t)GL_LCID, p2);
+				qrtr_rx(gl_msgbuf, gl_msglen);
+				gl_msglen = 0;
+			}
+			break;
+		}
+		default:
+			printf("SWEET GLINK: unknown cmd %u p1 %u p2 %u (avail %u), dropping fifo\n", cmd, p1, p2, avail);
+			sm_w32(GL_RX_TAIL, sm_r32(GL_RX_HEAD));
+			return;
+		}
+	}
+}
+
+/* ---------------- QRTR v1 over IPCRTR ---------------- */
+#define QRTR_TYPE_DATA      1u
+#define QRTR_TYPE_HELLO     2u
+#define QRTR_TYPE_NEW_SERVER 4u
+#define QRTR_TYPE_NEW_LOOKUP 10u
+#define QRTR_PORT_CTRL      0xfffffffeu
+#define QRTR_LOCAL_NODE     1u
+#define QRTR_BCAST          0xffffffffu
+
+static uint8_t qmi_rsp[4096];
+static uint32_t qmi_rsp_len;
+static int qmi_rsp_ready;
+
+static uint32_t qrtr_remote_node = QRTR_BCAST, qrtr_wlfw_node, qrtr_wlfw_port, qrtr_have_wlfw, qrtr_hello_sent;
+
+static int
+qrtr_send(uint32_t type, uint32_t dst_node, uint32_t dst_port, uint32_t src_port, const void *payload, uint32_t plen)
+{
+	static uint8_t pkt[8192];
+	uint32_t h[8] = {1u, type, QRTR_LOCAL_NODE, src_port, 0, plen, dst_node, dst_port};
+	if (plen > sizeof(pkt) - 32) {
+		return EINVAL;
+	}
+	memcpy(pkt, h, 32);
+	if (plen) {
+		memcpy(pkt + 32, payload, plen);
+	}
+	return gl_send(pkt, 32 + plen);
+}
+
+static void
+qrtr_rx(const uint8_t *pkt, uint32_t len)
+{
+	if (len < 32) {
+		return;
+	}
+	uint32_t h[8];
+	memcpy(h, pkt, 32);
+	if (h[1] == QRTR_TYPE_DATA && h[7] == 0x4000u && h[3] != QRTR_PORT_CTRL) {
+		/* control answers (NEW_SERVER) arrive as data on our port too */
+		if (len - 32 == 20) {
+			uint32_t c[5];
+			memcpy(c, pkt + 32, 20);
+			if (c[0] == QRTR_TYPE_NEW_SERVER) {
+				printf("SWEET QRTR: server service %#x instance %#x node %u port %#x\n", c[1], c[2], c[3], c[4]);
+				if (c[1] == 0x45) {
+					qrtr_have_wlfw = 1;
+					qrtr_wlfw_node = c[3];
+					qrtr_wlfw_port = c[4];
+				}
+				return;
+			}
+		}
+		printf("SWEET QRTR: rx data %u bytes from %u:%#x\n", len - 32, h[2], h[3]);
+		/* QMI message for our client port */
+		uint32_t n = len - 32 < sizeof(qmi_rsp) ? len - 32 : sizeof(qmi_rsp);
+		memcpy(qmi_rsp, pkt + 32, n);
+		qmi_rsp_len = n;
+		qmi_rsp_ready = 1;
+		return;
+	}
+	printf("SWEET QRTR: rx type %u src %u:%#x dst %u:%#x size %u\n", h[1], h[2], h[3], h[6], h[7], h[5]);
+	if (h[1] == QRTR_TYPE_HELLO) {
+		qrtr_remote_node = h[2];
+	} else if (h[1] == QRTR_TYPE_NEW_SERVER && len >= 32 + 20) {
+		uint32_t c[5];
+		memcpy(c, pkt + 32, 20);
+		printf("SWEET QRTR: server service %#x instance %#x node %u port %#x\n", c[1], c[2], c[3], c[4]);
+		if (c[1] == 0x45) {
+			qrtr_have_wlfw = 1;
+			qrtr_wlfw_node = c[3];
+			qrtr_wlfw_port = c[4];
+		}
+	} else if (h[1] == QRTR_TYPE_DATA && h[3] == QRTR_PORT_CTRL && h[5] >= 20 && len >= 32 + 20) {
+		uint32_t c[5];
+		memcpy(c, pkt + 32, 20);
+		if (c[0] == QRTR_TYPE_NEW_SERVER) {
+			printf("SWEET QRTR: server service %#x instance %#x node %u port %#x\n", c[1], c[2], c[3], c[4]);
+			if (c[1] == 0x45) {
+				qrtr_have_wlfw = 1;
+				qrtr_wlfw_node = c[3];
+				qrtr_wlfw_port = c[4];
+			}
+		}
+	}
+}
+
+static unsigned qrtr_lookup_tries;
+
+static void
+qrtr_start(void)
+{
+	if (qrtr_hello_sent && !qrtr_have_wlfw && (++qrtr_lookup_tries % 100) == 0 && qrtr_lookup_tries < 1500) {
+		uint32_t lookup[5] = {QRTR_TYPE_NEW_LOOKUP, 0, 0, 0, 0};
+		uint32_t node = qrtr_remote_node == QRTR_BCAST ? 0 : qrtr_remote_node;
+		qrtr_send(QRTR_TYPE_NEW_LOOKUP, node, QRTR_PORT_CTRL, 0x4000, lookup, 20);
+		printf("SWEET QRTR: NEW_LOOKUP again to node %u\n", node);
+	}
+	/* HELLO to everyone, then ask the remote name service for all servers */
+	if (!qrtr_hello_sent && gl_open_local && gl_open_remote && gl_nrint) {
+		uint32_t hello[5] = {QRTR_TYPE_HELLO, 0, 0, 0, 0};
+		if (!qrtr_send(QRTR_TYPE_HELLO, QRTR_BCAST, QRTR_PORT_CTRL, QRTR_PORT_CTRL, hello, 20)) {
+			uint32_t lookup[5] = {QRTR_TYPE_NEW_LOOKUP, 0, 0, 0, 0};
+			printf("SWEET QRTR: HELLO sent\n");
+			if (!qrtr_send(QRTR_TYPE_NEW_LOOKUP, QRTR_BCAST, QRTR_PORT_CTRL, 0x4000, lookup, 20)) {
+				qrtr_hello_sent = 1;
+				printf("SWEET QRTR: NEW_LOOKUP sent\n");
+			}
+		}
+	}
+}
+
+/* ---------------- QMI client for the WLAN firmware service (WLFW, service 0x45) ---------------- */
+#define WLFW_SERVICE            0x45
+#define WLFW_IND_REGISTER       0x20
+#define WLFW_MSA_INFO           0x2d
+#define WLFW_MSA_READY          0x2e
+#define WLFW_CAP                0x24
+#define WLFW_CLIENT_ID          0x4b4e454cu
+#define WLFW_MSA_PA             0x93900000ULL
+#define WLFW_MSA_SZ             0x200000u
+
+static uint16_t qmi_txn_id;
+
+static uint32_t
+qmi_tlv(uint8_t *b, uint32_t off, uint8_t tag, const void *val, uint16_t len)
+{
+	b[off] = tag;
+	memcpy(b + off + 1, &len, 2);
+	if (len) {
+		memcpy(b + off + 3, val, len);
+	}
+	return off + 3 + len;
+}
+
+/* send one QMI request to WLFW and poll for its response; returns the response TLV area or NULL */
+static const uint8_t *
+qmi_call(uint16_t msg_id, const uint8_t *tlvs, uint16_t tlen, uint32_t *rlen, unsigned timeout_ms)
+{
+	static uint8_t m[2048];
+	uint16_t txn = ++qmi_txn_id;
+	m[0] = 0;                               /* request */
+	memcpy(m + 1, &txn, 2);
+	memcpy(m + 3, &msg_id, 2);
+	memcpy(m + 5, &tlen, 2);
+	if (tlen) {
+		memcpy(m + 7, tlvs, tlen);
+	}
+	qmi_rsp_ready = 0;
+	for (unsigned tries = 0; tries < 50; ++tries) {
+		if (!qrtr_send(QRTR_TYPE_DATA, qrtr_wlfw_node, qrtr_wlfw_port, 0x4000, m, 7 + tlen)) {
+			break;
+		}
+		gl_poll();
+		touch_wait(20);
+	}
+	for (unsigned t = 0; t < timeout_ms / 10; ++t) {
+		gl_poll();
+		if (qmi_rsp_ready) {
+			qmi_rsp_ready = 0;
+			uint16_t rid, rl;
+			memcpy(&rid, qmi_rsp + 3, 2);
+			memcpy(&rl, qmi_rsp + 5, 2);
+			if (qmi_rsp[0] != 2 || rid != msg_id) {
+				continue;       /* an indication or somebody else's answer */
+			}
+			*rlen = rl;
+			return qmi_rsp + 7;
+		}
+		touch_wait(10);
+	}
+	return NULL;
+}
+
+/* find TLV `tag` in a message body */
+static const uint8_t *
+qmi_find(const uint8_t *b, uint32_t len, uint8_t tag, uint16_t *tl)
+{
+	uint32_t o = 0;
+	while (o + 3 <= len) {
+		uint16_t l;
+		memcpy(&l, b + o + 1, 2);
+		if (o + 3 + l > len) {
+			break;
+		}
+		if (b[o] == tag) {
+			*tl = l;
+			return b + o + 3;
+		}
+		o += 3 + l;
+	}
+	return NULL;
+}
+
+static int
+qmi_result(const char *what, const uint8_t *r, uint32_t rlen)
+{
+	uint16_t l = 0;
+	const uint8_t *res = r ? qmi_find(r, rlen, 0x02, &l) : NULL;
+	if (!res || l < 4) {
+		printf("SWEET WLFW: %s: no response\n", what);
+		return ETIMEDOUT;
+	}
+	uint16_t result, error;
+	memcpy(&result, res, 2);
+	memcpy(&error, res + 2, 2);
+	printf("SWEET WLFW: %s: result %u error %#x\n", what, result, error);
+	return result ? EIO : 0;
+}
