+static void
+sm_watch(void)
+{
+	printf("SWEET MODEM: watch start\n");
+	/* the window that loaded the firmware, re-pointed at SMEM */
+	sm_smem = sm_window(0);
+	if (!sm_smem) {
+		printf("SWEET MODEM: cannot map SMEM\n");
+		return;
+	}
+	sm_pmap_map_bd(sm_smem, SM_SMEM_PA, SM_SMEM_PA + SM_WIN, VM_PROT_READ | VM_PROT_WRITE);
+	__asm__ volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" : : : "memory");
+	sm_win_idx = -1;
+	sm_apcs = ml_io_map(SM_APCS_PA, 0x1000);
+	printf("SWEET MODEM: smem mapped at %#lx, apcs %#lx\n", (unsigned long)sm_smem, (unsigned long)sm_apcs);
+	sm_smem_dump();
+	sm_smp2p_setup();
+	int gl_started = 0;
+	for (unsigned t = 0; t < 1200; ++t) {
+		sm_smp2p_poll();
+		if (!gl_started && sm_p2p_in) {
+			gl_started = (gl_setup() == 0);
+		}
+		if (gl_started) {
+			gl_poll();
+			qrtr_start();
+			static int wlfw_done;
+			if (qrtr_have_wlfw && !wlfw_done) {
+				wlfw_done = 1;
+				wlfw_bringup();
+			}
+		}
+		if (t % 50 == 49) {
+			sm_kick(SM_IPC_SMP2P);
+			sm_kick(SM_IPC_GLINK);
+		}
+		if (t % 100 == 50) {
+			printf("SWEET GLINK: t=%u desc tx tail %u head %u rx tail %u head %u\n", t, sm_r32(GL_TX_TAIL),
+			    sm_r32(GL_TX_HEAD), sm_r32(GL_RX_TAIL), sm_r32(GL_RX_HEAD));
+		}
+		touch_wait(100);
+	}
+	printf("SWEET MODEM: watch done\n");
+}
+
+/* ---- backlight: PM6150L WLED5 modulator A through the SPMI arbiter (writes need the apps-owned channel) ---- */
+#define SP_CORE_PA      0x0c440000ULL
+#define SP_CNFG_PA      0x0c40a000ULL
+#define SP_CHNL_PA      0x0e400000ULL
+#define SP_NO_APID      0xffffu
+
+static vm_offset_t sp_core, sp_cnfg, sp_chnl;
+static uint16_t sp_wled_apid = 0;
+
+static uint16_t
+sp_find_apid(uint16_t ppid)
+{
+	uint16_t found = SP_NO_APID;
+	for (uint32_t i = 0; i < 512; ++i) {
+		uint32_t map = sm_r32(sp_core + 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = sm_r32(sp_cnfg + 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static int
+sp_write(uint16_t apid, uint8_t addr, uint32_t data, unsigned n)
+{
+	vm_offset_t ch = sp_chnl + 0x80u * apid;
+	sm_w32(ch + 0x10, data);
+	__asm__ volatile("dsb sy" : : : "memory");
+	sm_w32(ch, ((uint32_t)addr << 4) | (n - 1));      /* EXT_WRITEL */
+	for (unsigned i = 0; i < 2000; ++i) {
+		uint32_t st = sm_r32(ch + 0x08);
+		if (st & 1u) {
+			return (st & 0xeu) ? (int)st : 0;
+		}
+		delay(10);
+	}
+	return -1;
+}
+
+#define SP_OBS_PA       0x0e600000ULL
+static vm_offset_t sp_obs;
+
+static int
+sp_init(void)
+{
+	if (!sp_core) {
+		sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+		sp_cnfg = ml_io_map(SP_CNFG_PA, 0x1000);
+		sp_chnl = ml_io_map(SP_CHNL_PA, 0x10000);
+		sp_obs = ml_io_map(SP_OBS_PA, 0x10000);
+		if (!sp_core || !sp_cnfg || !sp_chnl || !sp_obs) {
+			sp_core = 0;
+			return ENOMEM;
+		}
+	}
+	return 0;
+}
+
+/* read one PMIC register through the read-only observer channel (same method as the key driver) */
+static int
+sp_read(uint16_t apid, uint8_t addr, uint8_t *out)
+{
+	vm_offset_t ch = sp_obs + 0x80u * apid;
+	sm_w32(ch, (1u << 27) | ((uint32_t)addr << 4));      /* EXT_READL, one byte */
+	__asm__ volatile("dsb sy" : : : "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = sm_r32(ch + 0x08);
+		if (st & 1u) {
+			if (st & 0xeu) {
+				return EIO;
+			}
+			*out = (uint8_t)sm_r32(ch + 0x18);
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* PM6150 RTC (SID 0, PID 0x60): seconds since the epoch, kept by the PMIC across reboots */
+static void
+sm_rtc_sync(void)
+{
+	if (sp_init()) {
+		return;
+	}
+	uint16_t apid = sp_find_apid(0x060);
+	if (apid == SP_NO_APID) {
+		printf("SWEET RTC: no apid for the RTC\n");
+		return;
+	}
+	uint8_t v[4], again = 0;
+	for (unsigned tries = 0; tries < 3; ++tries) {
+		for (unsigned i = 0; i < 4; ++i) {
+			if (sp_read(apid, 0x48 + i, &v[i])) {
+				printf("SWEET RTC: read failed\n");
+				return;
+			}
+		}
+		if (sp_read(apid, 0x48, &again) == 0 && again >= v[0]) {
+			break;
+		}
+	}
+	uint32_t secs = v[0] | (v[1] << 8) | (v[2] << 16) | ((uint32_t)v[3] << 24);
+	printf("SWEET RTC: PMIC seconds %u\n", secs);
+	if (secs > 1735689600u) {            /* later than 2025-01-01: a real time, not a reset RTC */
+		clock_set_calendar_microtime(secs, 0);
+		printf("SWEET RTC: system time set\n");
+	}
+}
+
+static int
+sm_bl_apply(unsigned level)
+{
+	if (!sp_wled_apid || sp_wled_apid == SP_NO_APID) {
+		if (sp_init()) {
+			return ENOMEM;
+		}
+		sp_wled_apid = sp_find_apid(0x5d9);
+		if (sp_wled_apid == SP_NO_APID) {
+			sp_wled_apid = sp_find_apid(0x4d9);
+		}
+		printf("SWEET BL: WLED sink apid %#x\n", sp_wled_apid);
+	}
+	if (sp_wled_apid == SP_NO_APID) {
+		return ENODEV;
+	}
+	int e = sp_write(sp_wled_apid, 0x53, (level & 0xff) | (((level >> 8) & 0xf) << 8), 2);
+	if (!e) {
+		e = sp_write(sp_wled_apid, 0x65, 1, 1);
+	}
+	if (!e) {
+		e = sp_write(sp_wled_apid, 0x65, 0, 1);
+	}
+	printf("SWEET BL: level %u -> %d\n", level, e);
+	return e ? EIO : 0;
+}
+
+static int sm_bl_level = 1072;
+
+static int
+sm_bl_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = sm_bl_level;
+	int err = sysctl_handle_int(oidp, &v, 0, req);
+	if (!err && req->newptr) {
+		if (v < 1) {
+			v = 1;
+		}
+		if (v > 4095) {
+			v = 4095;
+		}
+		sm_bl_level = v;
+		err = sm_bl_apply((unsigned)v);
+	}
+	return err;
+}
+
+SYSCTL_PROC(_hw, OID_AUTO, sweet_brightness, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sm_bl_sysctl, "I",
+    "panel backlight 1..4095");
