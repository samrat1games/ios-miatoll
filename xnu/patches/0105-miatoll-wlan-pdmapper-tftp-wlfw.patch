+static void
+tftp_request(uint32_t node, uint32_t port, const uint8_t *q, uint32_t qlen)
+{
+	if (qlen < 4 || q[0] != 0 || (q[1] != TFTP_RRQ && q[1] != TFTP_WRQ)) {
+		return;
+	}
+	const char *p = (const char *)q + 2, *end = (const char *)q + qlen;
+	const char *file = p;
+	size_t fl = strnlen(file, (size_t)(end - p));
+	if (p + fl >= end) {
+		return;
+	}
+	p += fl + 1;
+	const char *mode = p;
+	size_t ml = strnlen(mode, (size_t)(end - p));
+	if (p + ml >= end) {
+		return;
+	}
+	p += ml + 1;
+	int writer = q[1] == TFTP_WRQ, have_opts = p < end, want_tsize = 0, have_seek = 0;
+	uint32_t blksize = 512, wsize = 1, rsize = 0, timeoutms = 1000;
+	uint64_t seek = 0;
+	while (p < end) {
+		const char *k = p;
+		size_t kl = strnlen(k, (size_t)(end - p));
+		if (p + kl >= end) {
+			break;
+		}
+		const char *v = p + kl + 1;
+		size_t vl = strnlen(v, (size_t)(end - v));
+		if (v + vl >= end) {
+			break;
+		}
+		p = v + vl + 1;
+		if (!strcmp(k, "blksize")) {
+			blksize = tftp_num(v);
+		} else if (!strcmp(k, "timeoutms")) {
+			timeoutms = tftp_num(v);
+		} else if (!strcmp(k, "tsize")) {
+			want_tsize = 1;
+		} else if (!strcmp(k, "rsize")) {
+			rsize = tftp_num(v);
+		} else if (!strcmp(k, "wsize")) {
+			wsize = tftp_num(v);
+		} else if (!strcmp(k, "seek")) {
+			seek = tftp_num(v);
+			have_seek = 1;
+		}
+	}
+	if (blksize < 8 || blksize > TFTP_MAXBLK) {
+		blksize = blksize < 8 ? 512 : TFTP_MAXBLK;      /* RFC 2348: the server may answer a smaller blksize */
+	}
+	if (!wsize || wsize > 64) {
+		wsize = 1;
+	}
+	int i = 0;
+	while (i < TFTP_NCLIENT && tftp_cl[i].used) {
+		++i;
+	}
+	printf("SWEET TFTP: %s '%s' blksize %u wsize %u rsize %u seek %llu from %u:%#x\n", writer ? "WRQ" : "RRQ", file,
+	    blksize, wsize, rsize, seek, node, port);
+	if (i == TFTP_NCLIENT) {
+		tftp_error(node, port, TFTP_PORT, 0, "Resources temporarily unavailable");
+		return;
+	}
+	vnode_t vp = NULLVP;
+	uint64_t size = 0;
+	if (!writer) {
+		int e = tftp_open(file, &vp, &size);
+		if (e) {
+			printf("SWEET TFTP: '%s' not found (%d)\n", file, e);
+			tftp_error(node, port, TFTP_PORT, 1, "file not found");
+			return;
+		}
+	}
+	tftp_cl[i].used = 1;
+	tftp_cl[i].writer = writer;
+	tftp_cl[i].node = node;
+	tftp_cl[i].port = port;
+	tftp_cl[i].vp = vp;
+	tftp_cl[i].fsize = size;
+	tftp_cl[i].seek = seek;
+	tftp_cl[i].blksize = blksize;
+	tftp_cl[i].wsize = wsize;
+	tftp_cl[i].rsize = rsize;
+	tftp_cl[i].sent = 0;
+	strlcpy(tftp_cl[i].name, file, sizeof(tftp_cl[i].name));
+	if (have_opts) {
+		/* tqftpserv tftp_send_oack(): blksize, timeoutms, tsize (when asked), wsize, rsize (when set), seek (when set) */
+		uint8_t b[160] = {0, TFTP_OACK};
+		uint32_t o = 2;
+		o = tftp_opt(b, o, "blksize", blksize);
+		o = tftp_opt(b, o, "timeoutms", timeoutms);
+		if (want_tsize && !writer) {
+			o = tftp_opt(b, o, "tsize", size);
+		}
+		o = tftp_opt(b, o, "wsize", wsize);
+		if (rsize) {
+			o = tftp_opt(b, o, "rsize", rsize);
+		}
+		if (have_seek) {
+			o = tftp_opt(b, o, "seek", seek);
+		}
+		qrtr_send(QRTR_TYPE_DATA, node, port, TFTP_XPORT + (uint32_t)i, b, o);
+	} else if (writer) {
+		uint8_t a[4] = {0, TFTP_ACK, 0, 0};
+		qrtr_send(QRTR_TYPE_DATA, node, port, TFTP_XPORT + (uint32_t)i, a, 4);
+	} else {
+		tftp_cl[i].blk = 0;             /* no options: block 1 goes out without waiting for an ACK */
+		tftp_cl[i].blk_end = 1;
+		tftp_cl[i].sending = 1;
+	}
+}
+
+/* a packet to one transfer's port: ACKs for a reader, DATA for a writer */
+static void
+tftp_client_rx(uint32_t slot, uint32_t node, uint32_t port, const uint8_t *q, uint32_t qlen)
+{
+	if (slot >= TFTP_NCLIENT || !tftp_cl[slot].used || tftp_cl[slot].node != node || tftp_cl[slot].port != port ||
+	    qlen < 4) {
+		return;
+	}
+	uint16_t op = (uint16_t)(q[0] << 8 | q[1]), blk = (uint16_t)(q[2] << 8 | q[3]);
+	if (op == TFTP_ERROR) {
+		printf("SWEET TFTP: %s: client error %u\n", tftp_cl[slot].name, blk);
+		tftp_close((int)slot);
+		return;
+	}
+	if (tftp_cl[slot].writer) {
+		if (op != TFTP_DATA) {
+			return;
+		}
+		uint8_t a[4] = {0, TFTP_ACK, q[2], q[3]};
+		tftp_cl[slot].sent += qlen - 4;
+		qrtr_send(QRTR_TYPE_DATA, node, port, TFTP_XPORT + slot, a, 4);
+		if (qlen - 4 < tftp_cl[slot].blksize) {
+			tftp_close((int)slot);
+		}
+		return;
+	}
+	if (op != TFTP_ACK) {
+		tftp_error(node, port, TFTP_XPORT + slot, 4, "Expected ACK opcode");
+		tftp_close((int)slot);
+		return;
+	}
+	/* tqftpserv handle_reader() */
+	uint64_t bs = tftp_cl[slot].blksize;
+	if (tftp_cl[slot].rsize ? (uint64_t)blk * bs > tftp_cl[slot].rsize :
+	    (blk && (uint64_t)blk * bs > tftp_cl[slot].fsize)) {
+		tftp_close((int)slot);
+		return;
+	}
+	tftp_cl[slot].blk = blk;
+	tftp_cl[slot].blk_end = blk + tftp_cl[slot].wsize;
+	tftp_cl[slot].sending = 1;
+}
+
+static int qrtr_txq_room(void);
+
+static int
+tftp_busy(void)
+{
+	for (int i = 0; i < TFTP_NCLIENT; ++i) {
+		if (tftp_cl[i].used) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* send what the readers owe, as far as the QRTR queue has room; called from the watch loop and QMI waits */
+static void
+tftp_work(void)
+{
+	for (int i = 0; i < TFTP_NCLIENT; ++i) {
+		while (tftp_cl[i].used && tftp_cl[i].sending && qrtr_txq_room()) {
+			uint32_t b = tftp_cl[i].blk;
+			uint64_t bs = tftp_cl[i].blksize, off = tftp_cl[i].seek + (uint64_t)b * bs;
+			uint64_t want = bs, last = 0;
+			if (tftp_cl[i].rsize && (uint64_t)(b + 1) * bs > tftp_cl[i].rsize) {
+				want = tftp_cl[i].rsize % bs;      /* tqftpserv: response_size 0 means a whole block */
+				want = want ? want : bs;
+				last = 1;
+			}
+			uint64_t have = off < tftp_cl[i].fsize ? tftp_cl[i].fsize - off : 0;
+			uint32_t n = (uint32_t)(want < have ? want : have);
+			tftp_buf[0] = 0;
+			tftp_buf[1] = TFTP_DATA;
+			tftp_buf[2] = (uint8_t)((b + 1) >> 8);
+			tftp_buf[3] = (uint8_t)(b + 1);
+			if (n && sm_pread(tftp_cl[i].vp, tftp_buf + 4, n, (off_t)off)) {
+				tftp_error(tftp_cl[i].node, tftp_cl[i].port, TFTP_XPORT + (uint32_t)i, 0, "Read error");
+				tftp_close(i);
+				break;
+			}
+			qrtr_send(QRTR_TYPE_DATA, tftp_cl[i].node, tftp_cl[i].port, TFTP_XPORT + (uint32_t)i, tftp_buf, 4 + n);
+			tftp_cl[i].sent += n;
+			tftp_cl[i].blk = ++b;
+			if (last || n < bs || b >= tftp_cl[i].blk_end) {
+				tftp_cl[i].sending = 0;
+			}
+		}
+	}
+}
+
+/* NEW_SERVER for every service this side offers (rmtfs is announced by rfs_announce) */
+static void
+sm_announce_more(uint32_t node)
+{
+	uint32_t pdm[5] = {QRTR_TYPE_NEW_SERVER, PDM_SERVICE, PDM_INSTANCE, QRTR_LOCAL_NODE, PDM_PORT};
+	uint32_t tftp[5] = {QRTR_TYPE_NEW_SERVER, TFTP_SERVICE, TFTP_INSTANCE, QRTR_LOCAL_NODE, TFTP_PORT};
+	qrtr_send(QRTR_TYPE_NEW_SERVER, node, QRTR_PORT_CTRL, QRTR_PORT_CTRL, pdm, 20);
+	qrtr_send(QRTR_TYPE_NEW_SERVER, node, QRTR_PORT_CTRL, QRTR_PORT_CTRL, tftp, 20);
+}
