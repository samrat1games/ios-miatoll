+/* indications from WLFW (Linux ath10k_qmi_msg_handler) */
+static volatile int wlfw_fw_ready, wlfw_msa_ready_ind;
+
+static void
+wlfw_ind_rx(const uint8_t *q, uint32_t qlen)
+{
+	uint16_t id;
+	memcpy(&id, q + 3, 2);
+	printf("SWEET WLFW: indication %#x (%u bytes)\n", id, qlen);
+	if (id == WLFW_FW_READY_IND) {
+		wlfw_fw_ready = 1;
+	} else if (id == WLFW_MSA_READY_IND) {
+		wlfw_msa_ready_ind = 1;
+	}
+}
+
+/* ath10k_qmi_bdf_dnld_send_sync(): the board file in 6144-byte segments. icnss (Android) does not send it:
+ * the WLAN firmware reads bdwlan itself over TFTP. Boot-arg sweetwlbdf=1 sends it the ath10k way. */
+static void
+wlfw_bdf_download(uint32_t board_id)
+{
+	char name[16];
+	vnode_t vp = NULLVP;
+	snprintf(name, sizeof(name), "BDWLAN.B%02X", board_id & 0xff);
+	if (board_id == 0xff || sm_open(name, &vp)) {
+		strlcpy(name, "BDWLAN.BIN", sizeof(name));
+		if (sm_open(name, &vp)) {
+			printf("SWEET WLFW: no board file\n");
+			return;
+		}
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	uint32_t total = vnode_getattr(vp, &va, vfs_context_kernel()) ? 0 : (uint32_t)va.va_data_size;
+	static uint8_t t[6144 + 64];
+	uint32_t seg = 0, rl = 0;
+	for (uint32_t off = 0; off < total; ++seg) {
+		uint16_t n = (uint16_t)(total - off > 6144 ? 6144 : total - off);
+		uint8_t one = 1, end = off + n >= total;
+		uint32_t fid = 0, o = 0;
+		o = qmi_tlv(t, o, 0x01, &one, 1);
+		o = qmi_tlv(t, o, 0x10, &fid, 4);
+		o = qmi_tlv(t, o, 0x11, &total, 4);
+		o = qmi_tlv(t, o, 0x12, &seg, 4);
+		/* data: u16 length then the bytes */
+		t[o] = 0x13;
+		uint16_t dl = (uint16_t)(n + 2);
+		memcpy(t + o + 1, &dl, 2);
+		memcpy(t + o + 3, &n, 2);
+		if (sm_pread(vp, t + o + 5, n, (off_t)off)) {
+			break;
+		}
+		o += 5u + n;
+		o = qmi_tlv(t, o, 0x14, &end, 1);
+		const uint8_t *r = qmi_call(WLFW_BDF_DOWNLOAD, t, (uint16_t)o, &rl, 5000);
+		if (qmi_result(end ? "bdf (last segment)" : "bdf", r, rl) && !end) {
+			break;
+		}
+		off += n;
+	}
+	printf("SWEET WLFW: %s, %u bytes, %u segment(s)\n", name, total, seg);
+	vnode_put(vp);
+}
