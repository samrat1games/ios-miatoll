+/* ---------------- QMI messages from the services this side offers ---------------- */
+static int
+qmi_send_msg(uint8_t type, uint32_t node, uint32_t port, uint32_t src_port, uint16_t txn, uint16_t msg,
+    const uint8_t *tlvs, uint16_t tlen)
+{
+	static uint8_t m[1024];
+	if (tlen > sizeof(m) - 7) {
+		return EINVAL;
+	}
+	m[0] = type;
+	memcpy(m + 1, &txn, 2);
+	memcpy(m + 3, &msg, 2);
+	memcpy(m + 5, &tlen, 2);
+	memcpy(m + 7, tlvs, tlen);
+	return qrtr_send(QRTR_TYPE_DATA, node, port, src_port, m, 7u + tlen);
+}
+
+/*
+ * ---------------- pd-mapper: the service-registry locator (QMI service 0x40) ----------------
+ * The modem starts its WLAN protection domain (wlan_pd, which runs the WLFW service 0x45) only after the
+ * apps side answers "where does wlan/fw live". Linux: linux-msm/pd-mapper. Table from MODEMR.JSN and
+ * MODEMUW.JSN of the modem partition (qmi_instance_id 180).
+ */
+
+static const struct { const char *service, *domain; uint32_t instance; } pdm_map[] = {
+	{"tms/servreg", "msm/modem/root_pd", 180}, {"tms/pdr_enabled", "msm/modem/root_pd", 180},
+	{"gps/gps_service", "msm/modem/root_pd", 180}, {"kernel/elf_loader", "msm/modem/wlan_pd", 180},
+	{"tms/servreg", "msm/modem/wlan_pd", 180}, {"wlan/fw", "msm/modem/wlan_pd", 180},
+};
+
+static void
+pdm_request(uint32_t node, uint32_t port, const uint8_t *q, uint32_t qlen)
+{
+	if (qlen < 7 || q[0] != 0) {
+		return;
+	}
+	uint16_t txn, msg, tlen;
+	memcpy(&txn, q + 1, 2);
+	memcpy(&msg, q + 3, 2);
+	memcpy(&tlen, q + 5, 2);
+	if (7u + tlen > qlen) {
+		tlen = (uint16_t)(qlen - 7);
+	}
+	static uint8_t r[512];
+	uint32_t o = 0;
+	uint16_t res[2] = {0, 0};
+	char name[66] = {0};
+	uint16_t nl = 0;
+	const uint8_t *n = qmi_find(q + 7, tlen, 0x01, &nl);
+	if (msg != PDM_GET_DOMAIN_LIST || !n) {
+		printf("SWEET PDM: message %#x from %u:%#x not handled\n", msg, node, port);
+		res[0] = 1;
+		res[1] = msg != PDM_GET_DOMAIN_LIST ? 0x5e : 2;       /* QMI_ERR_NOT_SUPPORTED / MALFORMED_MSG */
+		o = qmi_tlv(r, 0, 0x02, res, 4);
+		qmi_send_msg(2, node, port, PDM_PORT, txn, msg, r, (uint16_t)o);
+		return;
+	}
+	memcpy(name, n, nl < 65 ? nl : 65);
+	uint16_t total = 0, rev = 1;
+	uint8_t list[400];
+	uint32_t lo = 1;
+	for (uint32_t i = 0; i < sizeof(pdm_map) / sizeof(pdm_map[0]); ++i) {
+		if (strcmp(pdm_map[i].service, name)) {
+			continue;
+		}
+		uint8_t dl = (uint8_t)strlen(pdm_map[i].domain), zero = 0;
+		uint32_t zero4 = 0;
+		list[lo++] = dl;                                       /* string inside a struct: u8 length + bytes */
+		memcpy(list + lo, pdm_map[i].domain, dl);
+		lo += dl;
+		memcpy(list + lo, &pdm_map[i].instance, 4);
+		lo += 4;
+		list[lo++] = zero;                                     /* service_data_valid */
+		memcpy(list + lo, &zero4, 4);                          /* service_data */
+		lo += 4;
+		total++;
+	}
+	list[0] = (uint8_t)total;
+	printf("SWEET PDM: '%s' from %u:%#x -> %u domain(s)\n", name, node, port, total);
+	o = qmi_tlv(r, 0, 0x02, res, 4);
+	o = qmi_tlv(r, o, 0x10, &total, 2);
+	o = qmi_tlv(r, o, 0x11, &rev, 2);
+	if (total) {
+		o = qmi_tlv(r, o, 0x12, list, (uint16_t)lo);
+	}
+	qmi_send_msg(2, node, port, PDM_PORT, txn, msg, r, (uint16_t)o);
+}
+
+/*
+ * ---------------- TFTP over QRTR (service 4096): the modem reads WLANMDSP.MBN and friends ----------------
+ * Behaviour of linux-msm/tqftpserv: options blksize/timeoutms/tsize/wsize/rsize/seek, OACK, the client ACKs
+ * block 0, then windows of wsize blocks; with rsize the client reads rsize bytes from seek and stops.
+ * Reads come from SM_FW_DIR (upper-case 8.3 names copied from the modem partition); writes are acknowledged
+ * and dropped.
+ */
+#define TFTP_RRQ                1
+#define TFTP_WRQ                2
+#define TFTP_DATA               3
+#define TFTP_ACK                4
+#define TFTP_ERROR              5
+#define TFTP_OACK               6
+
+static struct {
+	int used, writer, sending;
+	uint32_t node, port;
+	vnode_t vp;
+	uint64_t fsize, seek;
+	uint32_t blksize, wsize, rsize;
+	uint32_t blk, blk_end;          /* reader: next window is blocks blk+1 .. blk_end */
+	uint64_t sent;
+	char name[48];
+} tftp_cl[TFTP_NCLIENT];
+static uint8_t tftp_buf[TFTP_MAXBLK + 4];
+
+static void
+tftp_error(uint32_t node, uint32_t port, uint32_t src_port, uint16_t code, const char *msg)
+{
+	uint8_t b[64] = {0, TFTP_ERROR, (uint8_t)(code >> 8), (uint8_t)code};
+	size_t l = strlen(msg) < 58 ? strlen(msg) : 58;
+	memcpy(b + 4, msg, l);
+	b[4 + l] = 0;
+	qrtr_send(QRTR_TYPE_DATA, node, port, src_port, b, (uint32_t)(5 + l));
+}
+
+static void
+tftp_close(int i)
+{
+	if (tftp_cl[i].vp) {
+		vnode_put(tftp_cl[i].vp);
+	}
+	printf("SWEET TFTP: %s done, %llu bytes\n", tftp_cl[i].name, tftp_cl[i].sent);
+	memset(&tftp_cl[i], 0, sizeof(tftp_cl[i]));
+}
+
+/* "/readonly/firmware/image/wlanmdsp.mbn" -> SM_FW_DIR "WLANMDSP.MBN" */
+static int
+tftp_open(const char *path, vnode_t *vpp, uint64_t *size)
+{
+	static const char *const prefix[] = {"/readonly/firmware/image/", "/readonly/vendor/firmware_mnt/image/",
+		                             "/readonly/vendor/firmware/image/"};
+	const char *base = NULL;
+	for (unsigned i = 0; i < sizeof(prefix) / sizeof(prefix[0]) && !base; ++i) {
+		if (!strncmp(path, prefix[i], strlen(prefix[i]))) {
+			base = path + strlen(prefix[i]);
+		}
+	}
+	if (!base || !*base || strchr(base, '/') || strlen(base) > 31) {
+		return ENOENT;
+	}
+	char up[32];
+	size_t n = strlen(base);
+	for (size_t i = 0; i <= n; ++i) {
+		up[i] = (base[i] >= 'a' && base[i] <= 'z') ? (char)(base[i] - 32) : base[i];
+	}
+	int e = sm_open(up, vpp);
+	if (e) {
+		return e;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	e = vnode_getattr(*vpp, &va, vfs_context_kernel());
+	if (e) {
+		vnode_put(*vpp);
+		*vpp = NULLVP;
+		return e;
+	}
+	*size = va.va_data_size;
+	return 0;
+}
+
+static uint32_t
+tftp_num(const char *s)
+{
+	uint32_t v = 0;
+	while (*s >= '0' && *s <= '9') {
+		v = v * 10 + (uint32_t)(*s++ - '0');
+	}
+	return v;
+}
+
+static uint32_t
+tftp_opt(uint8_t *b, uint32_t o, const char *k, uint64_t v)
+{
+	size_t kl = strlen(k) + 1;
+	memcpy(b + o, k, kl);
+	o += (uint32_t)kl;
+	o += (uint32_t)snprintf((char *)b + o, 24, "%llu", v) + 1;
+	return o;
+}
