+/* ath10k_snoc_wlan_enable() tables for WCN3990 (drivers/net/wireless/ath/ath10k/snoc.c) */
+static const uint32_t wlfw_ce_tgt[12][5] = {    /* pipe, dir (1 in, 2 out, 3 inout), entries, max bytes, flags */
+	{0, 2, 32, 2048, 0}, {1, 1, 32, 2048, 0}, {2, 1, 64, 2048, 0}, {3, 2, 32, 2048, 0},
+	{4, 2, 256, 256, 8}, {5, 2, 1024, 64, 8}, {6, 3, 32, 16384, 0}, {7, 4, 0, 0, 8},
+	{8, 1, 32, 2048, 0}, {9, 1, 32, 2048, 0}, {10, 1, 32, 2048, 0}, {11, 1, 32, 2048, 0},
+};
+static const uint32_t wlfw_ce_svc[21][3] = {    /* HTC service, dir, pipe; the zero entry is sent too */
+	{0x104, 2, 3}, {0x104, 1, 2}, {0x102, 2, 3}, {0x102, 1, 2}, {0x101, 2, 3}, {0x101, 1, 2},
+	{0x103, 2, 3}, {0x103, 1, 2}, {0x100, 2, 3}, {0x100, 1, 2}, {0x001, 2, 0}, {0x001, 1, 2},
+	{0xfe00, 2, 0}, {0xfe00, 1, 2}, {0x300, 2, 4}, {0x300, 1, 1}, {0xfe00, 2, 5}, {0x301, 1, 9},
+	{0x302, 1, 10}, {0x600, 1, 11}, {0, 0, 0},
+};
+static const uint16_t wlfw_shadow[12][2] = {    /* CE, register (0x3c source write index, 0x40 dest write index) */
+	{0, 0x3c}, {3, 0x3c}, {4, 0x3c}, {5, 0x3c}, {7, 0x3c},
+	{1, 0x40}, {2, 0x40}, {7, 0x40}, {8, 0x40}, {9, 0x40}, {10, 0x40}, {11, 0x40},
+};
+
+static int
+wlfw_wlan_enable(void)
+{
+	static uint8_t t[1024], v[512];
+	uint32_t o = 0, rl = 0;
+	v[0] = 12;
+	memcpy(v + 1, wlfw_ce_tgt, sizeof(wlfw_ce_tgt));
+	o = qmi_tlv(t, o, 0x11, v, (uint16_t)(1 + sizeof(wlfw_ce_tgt)));
+	v[0] = 21;
+	memcpy(v + 1, wlfw_ce_svc, sizeof(wlfw_ce_svc));
+	o = qmi_tlv(t, o, 0x12, v, (uint16_t)(1 + sizeof(wlfw_ce_svc)));
+	v[0] = 12;
+	memcpy(v + 1, wlfw_shadow, sizeof(wlfw_shadow));
+	o = qmi_tlv(t, o, 0x13, v, (uint16_t)(1 + sizeof(wlfw_shadow)));
+	const uint8_t *r = qmi_call(WLFW_WLAN_CFG, t, (uint16_t)o, &rl, 5000);
+	if (qmi_result("wlan_cfg", r, rl)) {
+		return EIO;
+	}
+	uint32_t mode = 0;                      /* QMI_WLFW_MISSION_V01 */
+	uint8_t dbg = 0;
+	o = qmi_tlv(t, 0, 0x01, &mode, 4);
+	o = qmi_tlv(t, o, 0x10, &dbg, 1);
+	r = qmi_call(WLFW_WLAN_MODE, t, (uint16_t)o, &rl, 5000);
+	return qmi_result("wlan_mode mission", r, rl) ? EIO : 0;
+}
