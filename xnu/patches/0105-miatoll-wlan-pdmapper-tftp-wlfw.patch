+/*
+ * Read-only look at the apps SMMU (qcom,qsmmu-v500 @ 0x15000000) for the WLAN stream (iommus = <&apps_smmu 0xc0 0x1>):
+ * does a stream-match register already route SID 0xc0, and to bypass, fault or a context bank? The copy engine
+ * DMA (next step) depends on it. Boot-arg sweetwlsmmu=0 skips it.
+ */
+#define SMMU_PA         0x15000000ULL
+static void
+wlan_smmu_probe(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetwlsmmu", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	vm_offset_t g = ml_io_map(SMMU_PA, 0x1000);
+	if (!g) {
+		return;
+	}
+	uint32_t cr0 = sm_r32(g + 0x0), idr0 = sm_r32(g + 0x20), idr1 = sm_r32(g + 0x24);
+	uint32_t nsmr = idr0 & 0xff, ncb = idr1 & 0xff;
+	printf("SWEET WLSMMU: sCR0 %#x IDR0 %#x IDR1 %#x (%u SMRs, %u context banks)\n", cr0, idr0, idr1, nsmr, ncb);
+	for (uint32_t i = 0; i < nsmr && i < 128; ++i) {
+		uint32_t smr = sm_r32(g + 0x800 + 4 * i), s2cr = sm_r32(g + 0xc00 + 4 * i);
+		uint32_t id = smr & 0xffff, mask = (smr >> 16) & 0x7fff;
+		if ((smr & 0x80000000u) && ((id ^ 0xc0u) & ~mask & 0x7fffu) == 0) {
+			printf("SWEET WLSMMU: SMR%u %#x -> S2CR %#x (type %u, cb %u)\n", i, smr, s2cr, (s2cr >> 16) & 3,
+			    s2cr & 0xff);
+		}
+	}
+}
+
+static void
+wlfw_after_cap(uint32_t board_id)
+{
+	uint32_t bdf = 0;
+	(void)PE_parse_boot_argn("sweetwlbdf", &bdf, sizeof(bdf));
+	if (bdf) {
+		wlfw_bdf_download(board_id);
+	}
+	/* the firmware says FW_READY when it is up; meanwhile the modem may still read files over TFTP */
+	for (unsigned ms = 0; !wlfw_fw_ready && ms < 60000; ms += 10) {
+		gl_poll();
+		tftp_work();
+		touch_wait(10);
+	}
+	if (!wlfw_fw_ready) {
+		printf("SWEET WLFW: no FW_READY in 60 s\n");
+		return;
+	}
+	printf("SWEET WLFW: FW_READY\n");
+	if (!wlfw_wlan_enable()) {
+		printf("SWEET WLFW: WLAN firmware in mission mode, copy engine is next\n");
+	}
+	wlan_smmu_probe();
+}
