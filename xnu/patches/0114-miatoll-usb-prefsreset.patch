+/*
+ * "prefsreset <domain>": /private/var/mobile/Library/Preferences/<domain>.plist is copied to <domain>.plist.sweetbak
+ * and emptied, so iOS starts from its defaults at the next boot. For settings that crash SpringBoard (CoreUI effects
+ * need CoreImage on a GPU, SpringBoard died in CoreImage with pc 0) when there is no UI left to undo them.
+ */
+static int
+ud_prefs_reset(const char *domain, char *msg, size_t msglen)
+{
+	for (const char *c = domain; *c; ++c) {
+		if (!((*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') || (*c >= '0' && *c <= '9') || *c == '.' || *c == '-')) {
+			snprintf(msg, msglen, "bad domain\n");
+			return EINVAL;
+		}
+	}
+	char path[160], bak[176];
+	snprintf(path, sizeof(path), "/private/var/mobile/Library/Preferences/%s.plist", domain);
+	snprintf(bak, sizeof(bak), "%s.sweetbak", path);
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP, bp = NULLVP;
+	int e = vnode_open(path, FREAD | FWRITE, 0, 0, &vp, ctx);
+	if (e) {
+		snprintf(msg, msglen, "%s: open %d\n", path, e);
+		return e;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	e = vnode_getattr(vp, &va, ctx);
+	size_t size = e ? 0 : (size_t)va.va_data_size;
+	void *buf = NULL;
+	if (!e && (size == 0 || size > 1024 * 1024)) {
+		e = EFBIG;
+	}
+	if (!e && (buf = kalloc_data(size, Z_WAITOK)) == NULL) {
+		e = ENOMEM;
+	}
+	int resid = 0;
+	if (!e) {
+		e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)size, 0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+	}
+	if (!e) {
+		e = vnode_open(bak, O_CREAT | O_TRUNC | FWRITE, 0644, 0, &bp, ctx);
+	}
+	if (!e) {
+		e = vn_rdwr(UIO_WRITE, bp, (caddr_t)buf, (int)(size - (size_t)resid), 0, UIO_SYSSPACE, IO_NOAUTH,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		(void)vnode_close(bp, FWRITE, ctx);
+	}
+	if (!e) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_data_size, 0);
+		e = vnode_setattr(vp, &va, ctx);
+	}
+	(void)vnode_close(vp, FREAD | FWRITE, ctx);
+	if (buf) {
+		kfree_data(buf, size);
+	}
+	snprintf(msg, msglen, "%s: %s (%lu bytes kept in .sweetbak)\n", path, e ? "failed" : "emptied", (unsigned long)size);
+	printf("SWEET USB: prefsreset %s -> %d\n", domain, e);
+	return e;
+}
