+/*
+ * Remote control over the USB network (the phone's "adb"): UDP port 5141 on 192.168.7.2.
+ *   ping        -> "pong"
+ *   log         -> the live log (port 5140) starts again from the oldest byte the ring still holds
+ *   bootloader  -> cold restart into fastboot (the sweetbl path)
+ *   reboot      -> cold restart (back to the boot partition)
+ * Every command is answered to the sender before it is carried out. Boot-arg sweetusbcmd=0 turns it off.
+ */
+extern void sweet_remote_bootloader(void);
+extern void sweet_remote_reboot(void);
+
+static void
+ud_cmd_send(socket_t so, struct sockaddr_in *to, const char *text)
+{
+	struct iovec iov = { .iov_base = (void *)(uintptr_t)text, .iov_len = strlen(text) };
+	struct msghdr msg = {
+		.msg_name = to, .msg_namelen = sizeof(*to),
+		.msg_iov = &iov, .msg_iovlen = 1,
+	};
+	size_t sent = 0;
+	(void)sock_send(so, &msg, 0, &sent);
+}
+
+static void
+ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t so = NULL;
+	char buf[64];
+
+	for (;;) {
+		if (!ud.configured) {
+			ud_sleep_ms(200);
+			continue;
+		}
+		if (so == NULL) {
+			struct sockaddr_in me;
+			struct timeval tv = { .tv_sec = 1, .tv_usec = 0 };
+			if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+				so = NULL;
+				ud_sleep_ms(500);
+				continue;
+			}
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(5141);
+			me.sin_addr.s_addr = htonl(INADDR_ANY);
+			if (sock_bind(so, (struct sockaddr *)&me) != 0 ||
+			    sock_setsockopt(so, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) != 0) {
+				sock_close(so);
+				so = NULL;
+				ud_sleep_ms(1000);
+				continue;
+			}
+			printf("SWEET USB: command port udp/5141 open\n");
+		}
+		struct sockaddr_in from;
+		bzero(&from, sizeof(from));
+		struct iovec iov = { .iov_base = buf, .iov_len = sizeof(buf) - 1 };
+		struct msghdr msg = {
+			.msg_name = &from, .msg_namelen = sizeof(from),
+			.msg_iov = &iov, .msg_iovlen = 1,
+		};
+		size_t got = 0;
+		if (sock_receive(so, &msg, 0, &got) != 0 || got == 0) {
+			continue;               /* timeout */
+		}
+		buf[got] = 0;
+		while (got > 0 && (buf[got - 1] == '\n' || buf[got - 1] == '\r' || buf[got - 1] == ' ')) {
+			buf[--got] = 0;
+		}
+		printf("SWEET USB: command \"%s\"\n", buf);
+		if (strcmp(buf, "ping") == 0) {
+			ud_cmd_send(so, &from, "pong\n");
+		} else if (strcmp(buf, "log") == 0) {
+			ud_log_rewind = 1;
+			ud_cmd_send(so, &from, "ok, log from the start\n");
+		} else if (strcmp(buf, "bootloader") == 0) {
+			ud_cmd_send(so, &from, "restarting into the bootloader\n");
+			ud_sleep_ms(300);
+			sweet_remote_bootloader();
+		} else if (strcmp(buf, "reboot") == 0) {
+			ud_cmd_send(so, &from, "restarting\n");
+			ud_sleep_ms(300);
+			sweet_remote_reboot();
+		} else {
+			ud_cmd_send(so, &from, "unknown: ping, log, bootloader, reboot\n");
+		}
+	}
+}
