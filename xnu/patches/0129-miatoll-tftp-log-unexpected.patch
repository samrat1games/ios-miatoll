 	    qlen < 4) {
+		/* nobody expects this packet: say so, a silent drop hid the modem's answers before */
+		printf("SWEET TFTP: unexpected packet to slot %u from %u:%#x (slot used %d, expects %u:%#x), op %u blk %u, %u bytes\n",
