+/* 0178: HTC control messages (ath10k_htc_connect_service, ath10k_htc_start) on the control endpoint: pipe 0 up, pipe 2 down */
+static vm_offset_t wl_tx;
+static uint64_t wl_tx_pa;
+
+static void
+wl_wait_ms(unsigned ms_total, volatile int *flag)
+{
+	for (unsigned ms = 0; ms < ms_total && (!flag || *flag < 0); ms += 10) {
+		wl_ce_poll();
+		tftp_work();
+		touch_wait(10);
+	}
+}
+
+static int
+wl_htc_ctrl_send(const uint8_t *payload, uint16_t len)
+{
+	if (!wl_tx && wl_alloc(0x1000, &wl_tx, &wl_tx_pa)) {
+		return ENOMEM;
+	}
+	uint8_t *p = (uint8_t *)wl_tx;
+	memset(p, 0, 8 + len);
+	p[0] = 0;                               /* endpoint 0 */
+	p[2] = (uint8_t)len;
+	p[3] = (uint8_t)(len >> 8);
+	memcpy(p + 8, payload, len);
+	wl_sync(wl_tx, wl_tx_pa, 8u + len);
+	return wl_ce_send(0, wl_tx_pa, (uint16_t)(8u + len), 0);
+}
+
+/* HTC_MSG_CONNECT_SERVICE: message id 2, service id, flags, extra length; the answer says which endpoint carries the service */
+static int
+wl_htc_connect(uint16_t service, uint16_t flags)
+{
+	uint8_t m[8] = {0};
+	m[0] = 2;
+	m[2] = (uint8_t)service;
+	m[3] = (uint8_t)(service >> 8);
+	m[4] = (uint8_t)flags;
+	m[5] = (uint8_t)(flags >> 8);
+	wl_conn_status = -1;
+	int err = wl_htc_ctrl_send(m, sizeof(m));
+	if (err) {
+		return err;
+	}
+	wl_wait_ms(2000, &wl_conn_status);
+	return wl_conn_status == 0 ? 0 : wl_conn_status < 0 ? ETIMEDOUT : EIO;
+}
+
+/* HTC_MSG_SETUP_COMPLETE_EX: message id 6, then zeros (no bundling): the target starts sending WMI events */
+static int
+wl_htc_start(void)
+{
+	uint8_t m[14] = {0};
+	m[0] = 6;
+	return wl_htc_ctrl_send(m, sizeof(m));
+}
