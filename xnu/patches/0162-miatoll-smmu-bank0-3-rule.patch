-			printf("SWEET WLSMMU: SID 0xc0 -> %s (ok %d), SMR%d %#x S2CR %#x, sGFSR %#x\n",
+		/* exact for SMR (valid, mask 1, SID 0xc0); S2CR: type + context bank (firmware may add MEMATTR bits) */
+		int okk = rs == 0x800100c0u && (rc & 0x300ffu) == (rule & 0x300ffu);
+		printf("SWEET WLSMMU: SID 0xc0 rule: SMR%d %#x S2CR%d %#x (type %u cb %u), want S2CR %#x -> %s\n", smr, rs, smr,
+		    rc, (rc >> 16) & 3, rc & 0xffu, rule, okk ? "physical DMA should work" : "refused");
+		for (unsigned r = 0; r < 10; ++r) {                     /* the USB log drops bursts: repeat the verdict */
+			printf("SWEET WLSMMU: SID 0xc0 -> %s (ok %d), SMR%d %#x S2CR %#x, sGFSR %#x sACR %#x\n",
 			    quirk ? "shared bypass bank" : "S2CR bypass", okk, smr,
-			    sm_r32(g + 0x800 + 4 * (uint32_t)smr), sm_r32(g + 0xc00 + 4 * (uint32_t)smr), sm_r32(g + 0x48));
-			touch_wait(3000);
+			    sm_r32(g + 0x800 + 4 * (uint32_t)smr), sm_r32(g + 0xc00 + 4 * (uint32_t)smr), sm_r32(g + 0x48),
