+	 * banks are all the 0153 rule needs.
+	 */
+	printf("SWEET WLSMMU: bank scan of %u banks, reading 0-3 only\n", ncb);
 	touch_wait(300);
-	for (uint32_t i = 0; i < ncb; i += 8) {
